-- test/test_scroll.march
-- Tests for the Scroll notebook engine.
--
-- Covers:
--   parse_cells         — unit tests for .scrollmd markdown parsing
--   generate_runner     — unit tests for March source code generation
--   extract_cell_output — unit tests for sentinel-based output extraction
--   Integration         — run generated runners via System.cmd and check stdout
--
-- Run with:
--   MARCH_LIB_PATH=/Users/80197052/code/scroll/src \
--     march test test/test_scroll.march

mod TestScroll do

-- ── Helpers ───────────────────────────────────────────────────────────────────

-- Write string to a temp file, return path.
fn write_tmp(content, suffix) do
  let path = "/tmp/test_scroll_" ++ String.from_int(System.pid()) ++ suffix
  match File.write(path, content) do
    Ok(_) -> Ok(path)
    Err(e) -> Err(e)
  end
end

-- Run march on a source string; return (exit_code, stdout, stderr).
fn run_march(march_src) do
  match write_tmp(march_src, ".march") do
    Err(e) -> (-1, "", "write_tmp failed: " ++ to_string(e))
    Ok(tmp) ->
      match System.cmd("march", [tmp]) do
        Ok(r) -> (System.exit_code(r), System.stdout(r), System.stderr(r))
        Err(e) -> (-1, "", e)
      end
  end
end

-- Parse notebook content, generate runner through nb_idx, execute,
-- and return (exit_code, raw_stdout).
fn run_nb(nb_content, nb_idx) do
  let cells = Scroll.parse_cells(nb_content)
  let runner = Scroll.generate_runner(cells, nb_idx)
  let (rc, stdout, _) = run_march(runner)
  (rc, stdout)
end

-- ── Property test helpers ────────────────────────────────────────────────────
-- These must be defined before the first describe block so march's type
-- inference can resolve them without context from unit tests.

-- Convert a list of char-code integers to a String.
-- Uses List.map + String.join to avoid Nil/Cons ambiguity in type inference.
pfn codes_to_str(lst : List(Int)) : String do
  String.join(List.map(lst, fn h -> Char.to_string(Char.from_int(h))), "")
end

-- Generator of lowercase letter (a-z) code lists.
pfn lc_codes() do Gen.list(Gen.int(97, 122)) end

-- Generator of printable ASCII (32-126) code lists, includes ", \, <, >, etc.
pfn ascii_codes() do Gen.list(Gen.int(32, 126)) end

-- ── parse_cells ───────────────────────────────────────────────────────────────

describe "parse_cells" do

  test "empty string yields no cells" do
    let cells = Scroll.parse_cells("")
    assert (List.length(cells) == 0)
  end

  test "plain text yields one Markdown cell" do
    let cells = Scroll.parse_cells("Hello, world!")
    assert (List.length(cells) == 1)
    match cells do
      Cons(cell, Nil) -> assert (Scroll.cell_tag(cell) == "Markdown")
      _ -> assert false
    end
  end

  test "a code fence yields one Code cell" do
    let src = "```march\nprintln(\"hi\")\n```"
    let cells = Scroll.parse_cells(src)
    assert (List.length(cells) == 1)
    match cells do
      Cons(cell, Nil) -> assert (Scroll.cell_tag(cell) == "Code")
      _ -> assert false
    end
  end

  test "code cell contains correct source" do
    let src = "```march\n1 + 1\n```"
    let cells = Scroll.parse_cells(src)
    match cells do
      Cons(cell, Nil) ->
        assert (String.trim(Scroll.cell_source(cell)) == "1 + 1")
      _ -> assert false
    end
  end

  test "markdown before code fence is kept" do
    let src = "# Title\n\n```march\n42\n```"
    let cells = Scroll.parse_cells(src)
    assert (List.length(cells) == 2)
    let tags = List.map(cells, fn c -> Scroll.cell_tag(c))
    assert (List.nth(tags, 0) == "Markdown")
    assert (List.nth(tags, 1) == "Code")
  end

  test "multiple code cells parsed in order" do
    let src = "```march\n1\n```\n\n```march\n2\n```\n\n```march\n3\n```"
    let cells = Scroll.parse_cells(src)
    assert (List.length(cells) == 3)
    let all_code = List.all(cells, fn c -> Scroll.cell_tag(c) == "Code")
    assert all_code
  end

  test "whitespace-only text between fences is not a cell" do
    let src = "```march\n1\n```\n\n\n```march\n2\n```"
    let cells = Scroll.parse_cells(src)
    assert (List.length(cells) == 2)
  end

  test "mixed notebook: markdown, code, markdown, code" do
    let src = "# Intro\n\n```march\n1\n```\n\nSome text.\n\n```march\n2\n```"
    let cells = Scroll.parse_cells(src)
    assert (List.length(cells) == 4)
    let tags = List.map(cells, fn c -> Scroll.cell_tag(c))
    assert (List.nth(tags, 0) == "Markdown")
    assert (List.nth(tags, 1) == "Code")
    assert (List.nth(tags, 2) == "Markdown")
    assert (List.nth(tags, 3) == "Code")
  end

end

-- ── extract_cell_output ───────────────────────────────────────────────────────

describe "extract_cell_output" do

  test "extracts content between sentinel markers" do
    let stdout = "__MNB_START_0__\nhello\n__MNB_END_0__\n"
    let out = Scroll.extract_cell_output(stdout, 0)
    assert (out == "hello")
  end

  test "returns empty string when start marker missing" do
    let stdout = "no markers here"
    let out = Scroll.extract_cell_output(stdout, 0)
    assert (out == "")
  end

  test "handles multi-line output" do
    let stdout = "__MNB_START_1__\nline1\nline2\nline3\n__MNB_END_1__\n"
    let out = Scroll.extract_cell_output(stdout, 1)
    assert (out == "line1\nline2\nline3")
  end

  test "extracts correct cell when multiple present" do
    let stdout =
      "__MNB_START_0__\ncell0\n__MNB_END_0__\n" ++
      "__MNB_START_1__\ncell1\n__MNB_END_1__\n"
    let out0 = Scroll.extract_cell_output(stdout, 0)
    let out1 = Scroll.extract_cell_output(stdout, 1)
    assert (out0 == "cell0")
    assert (out1 == "cell1")
  end

  test "empty cell body yields empty string" do
    let stdout = "__MNB_START_0__\n__MNB_END_0__\n"
    let out = Scroll.extract_cell_output(stdout, 0)
    assert (out == "")
  end

  test "works for higher cell indices" do
    let stdout = "__MNB_START_42__\nvalue42\n__MNB_END_42__\n"
    let out = Scroll.extract_cell_output(stdout, 42)
    assert (out == "value42")
  end

  test "ignores content after end marker" do
    let stdout = "__MNB_START_0__\nresult\n__MNB_END_0__\nextra stuff\n"
    let out = Scroll.extract_cell_output(stdout, 0)
    assert (out == "result")
  end

  -- Issue #5: token-based marker path (session token present in stdout).
  test "extracts output with token-based markers" do
    let tok = "12345_0"
    let stdout =
      "__MNB_TOK_" ++ tok ++ "\n" ++
      "__MNB_S_" ++ tok ++ "_0__\nhello\n__MNB_E_" ++ tok ++ "_0__\n"
    let out = Scroll.extract_cell_output(stdout, 0)
    assert (out == "hello")
  end

  test "token markers take priority over legacy markers when token is present" do
    let tok = "99_1"
    let stdout =
      "__MNB_TOK_" ++ tok ++ "\n" ++
      "__MNB_S_" ++ tok ++ "_0__\ntok-output\n__MNB_E_" ++ tok ++ "_0__\n" ++
      "__MNB_START_0__\nlegacy-output\n__MNB_END_0__\n"
    let out = Scroll.extract_cell_output(stdout, 0)
    assert (out == "tok-output")
  end

end

-- ── extract_forge_adds ───────────────────────────────────────────────────────

describe "extract_forge_adds" do

  test "extracts forge add spec from sentinel line" do
    let stdout = "__FORGE_ADD__:json --git https://github.com/march-lang/json\n"
    let adds = Scroll.extract_forge_adds(stdout)
    assert (List.length(adds) == 1)
    assert (List.nth(adds, 0) == "json --git https://github.com/march-lang/json")
  end

  test "returns empty list when no sentinels present" do
    let stdout = "hello world\nno adds here\n"
    let adds = Scroll.extract_forge_adds(stdout)
    assert (List.length(adds) == 0)
  end

  test "extracts multiple forge adds" do
    let stdout = "__FORGE_ADD__:json --git url1\n__FORGE_ADD__:utils --path ../utils\n"
    let adds = Scroll.extract_forge_adds(stdout)
    assert (List.length(adds) == 2)
  end

  test "ignores non-sentinel lines mixed in" do
    let stdout = "hello\n__FORGE_ADD__:json\nworld\n"
    let adds = Scroll.extract_forge_adds(stdout)
    assert (List.length(adds) == 1)
    assert (List.nth(adds, 0) == "json")
  end

end

-- ── generate_runner ───────────────────────────────────────────────────────────

describe "generate_runner" do

  test "wraps output in NotebookRunner mod" do
    let cells = Scroll.parse_cells("```march\n1 + 1\n```")
    let runner = Scroll.generate_runner(cells, 0)
    assert (String.contains(runner, "mod NotebookRunner"))
  end

  test "includes start and end markers for cell 0" do
    -- Issue #5: runner now uses token-based markers __MNB_S_<tok>_N__ / __MNB_E_<tok>_N__.
    let cells = Scroll.parse_cells("```march\n1 + 1\n```")
    let runner = Scroll.generate_runner(cells, 0)
    assert (String.contains(runner, "__MNB_S_"))
    assert (String.contains(runner, "__MNB_E_"))
  end

  test "skips Markdown cells in sentinel numbering" do
    -- Markdown + one Code → only cell 0 sentinels in runner.
    -- Token-based suffix: _0__ for cell 0, _1__ for cell 1.
    let cells = Scroll.parse_cells("# Title\n\n```march\n42\n```")
    let runner = Scroll.generate_runner(cells, 1)
    assert (String.contains(runner, "_0__"))
    assert not(String.contains(runner, "_1__"))
  end

  test "runs only up to run_through_idx" do
    -- Token-based suffix: _0__, _1__, _2__ identify cell markers.
    let nb = "```march\n1\n```\n\n```march\n2\n```\n\n```march\n3\n```"
    let cells = Scroll.parse_cells(nb)
    let runner = Scroll.generate_runner(cells, 1)
    assert (String.contains(runner, "_0__"))
    assert (String.contains(runner, "_1__"))
    assert not(String.contains(runner, "_2__"))
  end

  test "let binding is suppressed (Jupyter convention)" do
    let cells = Scroll.parse_cells("```march\nlet x = 42\n```")
    let runner = Scroll.generate_runner(cells, 0)
    -- The captured result variable must be "()" for let-bindings
    assert (String.contains(runner, "let __r0__ = ()"))
  end

  test "expression result is captured" do
    let cells = Scroll.parse_cells("```march\n1 + 1\n```")
    let runner = Scroll.generate_runner(cells, 0)
    assert (String.contains(runner, "let __r0__ = 1 + 1"))
  end

  test "output of generate_runner is valid march source" do
    let cells = Scroll.parse_cells("```march\nprintln(\"ok\")\n```")
    let runner = Scroll.generate_runner(cells, 0)
    let (rc, _, _) = run_march(runner)
    assert (rc == 0)
  end

  -- Issue #5: generated runner must contain the session token sentinel line.
  test "generated runner contains session token line" do
    let cells = Scroll.parse_cells("```march\n1 + 1\n```")
    let runner = Scroll.generate_runner(cells, 0)
    assert (String.contains(runner, "__MNB_TOK_"))
  end

end

-- ── Integration: round-trip through parse → generate → execute ────────────────

describe "integration" do

  test "single expression cell prints result" do
    let (rc, stdout) = run_nb("```march\n1 + 1\n```", 0)
    assert (rc == 0)
    assert (Scroll.extract_cell_output(stdout, 0) == "2")
  end

  test "println output is captured" do
    let (rc, stdout) = run_nb("```march\nprintln(\"hello scroll\")\n```", 0)
    assert (rc == 0)
    assert (Scroll.extract_cell_output(stdout, 0) == "hello scroll")
  end

  test "let binding is silent (no auto-print)" do
    let (rc, stdout) = run_nb("```march\nlet x = 99\n```", 0)
    assert (rc == 0)
    assert (Scroll.extract_cell_output(stdout, 0) == "")
  end

  test "binding from earlier cell is visible in later cell" do
    let nb = "```march\nlet x = 7\n```\n\n```march\nx * 6\n```"
    let (rc, stdout) = run_nb(nb, 1)
    assert (rc == 0)
    assert (Scroll.extract_cell_output(stdout, 1) == "42")
  end

  test "string expression prints without extra quotes" do
    let (rc, stdout) = run_nb("```march\n\"hello\"\n```", 0)
    assert (rc == 0)
    assert (Scroll.extract_cell_output(stdout, 0) == "hello")
  end

  test "unit expression produces no output" do
    let (rc, stdout) = run_nb("```march\n()\n```", 0)
    assert (rc == 0)
    assert (Scroll.extract_cell_output(stdout, 0) == "")
  end

  test "markdown cells are ignored in runner" do
    let nb = "# My Notebook\n\n```march\n21 * 2\n```"
    -- cell index 1: the Code cell is the second overall cell
    let (rc, stdout) = run_nb(nb, 1)
    assert (rc == 0)
    -- code_n is 0 (first Code cell)
    assert (Scroll.extract_cell_output(stdout, 0) == "42")
  end

  test "syntax error causes non-zero exit" do
    let (rc, _stdout) = run_nb("```march\n@@@ not valid march @@@\n```", 0)
    assert (rc != 0)
  end

  test "multiple cells accumulate output independently" do
    let nb = "```march\nprintln(\"first\")\n```\n\n```march\nprintln(\"second\")\n```"
    let (rc, stdout) = run_nb(nb, 1)
    assert (rc == 0)
    assert (Scroll.extract_cell_output(stdout, 0) == "first")
    assert (Scroll.extract_cell_output(stdout, 1) == "second")
  end

  test "arithmetic accumulated across three cells" do
    let nb = "```march\nlet a = 10\n```\n\n```march\nlet b = 32\n```\n\n```march\na + b\n```"
    let (rc, stdout) = run_nb(nb, 2)
    assert (rc == 0)
    assert (Scroll.extract_cell_output(stdout, 2) == "42")
  end

  test "module defined in cell A is callable from cell B" do
    let cell_a = "```march\nmod Greet do\n  fn hello(name) do\n    \"Hello, \" ++ name ++ \"!\"\n  end\nend\n```"
    let cell_b = "```march\nGreet.hello(\"World\")\n```"
    let nb = cell_a ++ "\n\n" ++ cell_b
    let (rc, stdout) = run_nb(nb, 1)
    assert (rc == 0)
    assert (Scroll.extract_cell_output(stdout, 1) == "Hello, World!")
  end

  test "module cell produces no output itself" do
    let cell_a = "```march\nmod Util do\n  fn double(x) do x * 2 end\nend\n```"
    let nb = cell_a
    let (rc, stdout) = run_nb(nb, 0)
    assert (rc == 0)
    assert (Scroll.extract_cell_output(stdout, 0) == "")
  end

  test "multiple functions from module cell work in later cells" do
    let cell_a = "```march\nmod MathUtil do\n  fn double(x) do x * 2 end\n  fn square(x) do x * x end\nend\n```"
    let cell_b = "```march\nMathUtil.double(MathUtil.square(3))\n```"
    let nb = cell_a ++ "\n\n" ++ cell_b
    let (rc, stdout) = run_nb(nb, 1)
    assert (rc == 0)
    assert (Scroll.extract_cell_output(stdout, 1) == "18")
  end

  -- Issue #7: string literal containing closing brackets must not trigger multi-line scan.
  test "string with closing brackets in value is not misclassified as continuation" do
    let nb = "```march\n\"result: )))\"\n```"
    let (rc, stdout) = run_nb(nb, 0)
    assert (rc == 0)
    assert (Scroll.extract_cell_output(stdout, 0) == "result: )))")
  end

end

-- ── html_escape ───────────────────────────────────────────────────────────────

describe "html_escape" do

  test "escapes ampersand" do
    assert (Scroll.html_escape("a & b") == "a &amp; b")
  end

  test "escapes angle brackets" do
    assert (Scroll.html_escape("<div>") == "&lt;div&gt;")
  end

  test "escapes double quote" do
    assert (Scroll.html_escape("\"x\"") == "&quot;x&quot;")
  end

  test "handles empty string" do
    assert (Scroll.html_escape("") == "")
  end

  test "leaves safe chars untouched" do
    assert (Scroll.html_escape("hello world") == "hello world")
  end

  test "escapes ampersand before angle brackets (order matters)" do
    -- Must escape & first, otherwise &lt; would become &amp;lt;
    assert (Scroll.html_escape("<") == "&lt;")
  end

end

-- ── json_escape / json_str ────────────────────────────────────────────────────

describe "json_escape" do

  test "escapes backslash" do
    assert (Scroll.json_escape("a\\b") == "a\\\\b")
  end

  test "escapes double quote" do
    assert (Scroll.json_escape("say \"hi\"") == "say \\\"hi\\\"")
  end

  test "escapes newline" do
    assert (Scroll.json_escape("a\nb") == "a\\nb")
  end

  test "escapes tab" do
    assert (Scroll.json_escape("a\tb") == "a\\tb")
  end

  test "handles empty string" do
    assert (Scroll.json_escape("") == "")
  end

  test "leaves plain ascii unchanged" do
    assert (Scroll.json_escape("hello") == "hello")
  end

  -- Issue #17: control chars below U+0020 that lack named escapes.
  test "escapes NUL byte as \\u0000" do
    let nul = Char.to_string(Char.from_int(0))
    assert (Scroll.json_escape(nul) == "\\u0000")
  end

  test "escapes BEL (0x07) as \\u0007" do
    let bel = Char.to_string(Char.from_int(7))
    assert (Scroll.json_escape(bel) == "\\u0007")
  end

  test "escapes VT (0x0B) as \\u000b" do
    let vt = Char.to_string(Char.from_int(11))
    assert (Scroll.json_escape(vt) == "\\u000b")
  end

  test "control chars in mixed string are all escaped" do
    let nul = Char.to_string(Char.from_int(0))
    let result = Scroll.json_escape("a" ++ nul ++ "b")
    assert (result == "a\\u0000b")
  end

end

describe "json_str" do

  test "wraps plain string in quotes" do
    assert (Scroll.json_str("hi") == "\"hi\"")
  end

  test "escapes inner quotes" do
    assert (Scroll.json_str("a\"b") == "\"a\\\"b\"")
  end

  test "empty string becomes empty quoted" do
    assert (Scroll.json_str("") == "\"\"")
  end

end

-- ── nth_cell ──────────────────────────────────────────────────────────────────

describe "nth_cell" do

  test "first cell returns Some(cell0)" do
    let cells = Scroll.parse_cells("```march\n1\n```\n\n```march\n2\n```")
    match Scroll.nth_cell(cells, 0) do
      Some(c) -> assert (String.trim(Scroll.cell_source(c)) == "1")
      None -> assert false
    end
  end

  test "second cell returns correct cell" do
    let cells = Scroll.parse_cells("```march\n1\n```\n\n```march\n2\n```")
    match Scroll.nth_cell(cells, 1) do
      Some(c) -> assert (String.trim(Scroll.cell_source(c)) == "2")
      None -> assert false
    end
  end

  test "out-of-range index returns None" do
    let cells = Scroll.parse_cells("```march\n1\n```")
    match Scroll.nth_cell(cells, 5) do
      None -> assert true
      Some(_) -> assert false
    end
  end

  test "empty list returns None" do
    match Scroll.nth_cell(Nil, 0) do
      None -> assert true
      Some(_) -> assert false
    end
  end

end

-- ── Section cells ─────────────────────────────────────────────────────────────

describe "Section cells" do

  test "section comment parses as Section cell" do
    let src = "<!-- section: Intro -->\n\n```march\n1\n```"
    let cells = Scroll.parse_cells(src)
    assert (List.length(cells) == 2)
    match cells do
      Cons(first, _) -> assert (Scroll.cell_tag(first) == "Section")
      _ -> assert false
    end
  end

  test "section source stores the title" do
    let src = "<!-- section: Intro -->"
    let cells = Scroll.parse_cells(src)
    match cells do
      Cons(c, Nil) ->
        assert (Scroll.cell_tag(c) == "Section")
        assert (Scroll.cell_source(c) == "Intro")
      _ -> assert false
    end
  end

  test "section interleaves with code and markdown" do
    let src = "# Title\n\n<!-- section: Part 1 -->\n\n```march\n1\n```"
    let cells = Scroll.parse_cells(src)
    assert (List.length(cells) == 3)
    let tags = List.map(cells, fn c -> Scroll.cell_tag(c))
    assert (List.nth(tags, 0) == "Markdown")
    assert (List.nth(tags, 1) == "Section")
    assert (List.nth(tags, 2) == "Code")
  end

end

-- ── extract_vars ──────────────────────────────────────────────────────────────

describe "extract_vars" do

  test "returns empty list when no vars block present" do
    let vars = Scroll.extract_vars("nothing here")
    assert (List.length(vars) == 0)
  end

  test "extracts a single var" do
    let stdout = "__MNB_VARS__\nx=42\n__MNB_VARS_END__\n"
    let vars = Scroll.extract_vars(stdout)
    assert (List.length(vars) == 1)
    let (name, value) = List.nth(vars, 0)
    assert (name == "x")
    assert (value == "42")
  end

  test "extracts multiple vars" do
    let stdout = "__MNB_VARS__\na=1\nb=two\nc=\n__MNB_VARS_END__\n"
    let vars = Scroll.extract_vars(stdout)
    assert (List.length(vars) == 3)
  end

  test "ignores content before and after vars block" do
    let stdout = "pre\n__MNB_VARS__\nk=v\n__MNB_VARS_END__\npost\n"
    let vars = Scroll.extract_vars(stdout)
    assert (List.length(vars) == 1)
    let (name, value) = List.nth(vars, 0)
    assert (name == "k")
    assert (value == "v")
  end

end

-- ── strip_forge_adds ──────────────────────────────────────────────────────────

describe "strip_forge_adds" do

  test "removes forge add sentinel line" do
    let out = "hello\n__FORGE_ADD__:json\nworld\n"
    let clean = Scroll.strip_forge_adds(out)
    assert not(String.contains(clean, "__FORGE_ADD__"))
    assert (String.contains(clean, "hello"))
    assert (String.contains(clean, "world"))
  end

  test "preserves output with no sentinels" do
    let out = "just normal output\n"
    assert (Scroll.strip_forge_adds(out) == out)
  end

  test "handles empty string" do
    assert (Scroll.strip_forge_adds("") == "")
  end

  test "removes multiple sentinel lines" do
    let out = "__FORGE_ADD__:a\n__FORGE_ADD__:b\nkeep\n"
    let clean = Scroll.strip_forge_adds(out)
    assert not(String.contains(clean, "__FORGE_ADD__"))
    assert (String.contains(clean, "keep"))
  end

end

-- ── find_code_idx ─────────────────────────────────────────────────────────────

describe "find_code_idx" do

  test "first code cell at overall idx 0 maps to 0" do
    let cells = Scroll.parse_cells("```march\n1\n```")
    assert (Scroll.find_code_idx(cells, 0) == 0)
  end

  test "code cell after markdown maps correctly" do
    let cells = Scroll.parse_cells("# Title\n\n```march\n1\n```")
    -- overall idx 1 is the code cell; code-n is 0 (first code)
    assert (Scroll.find_code_idx(cells, 1) == 0)
  end

  test "second code cell maps to code-n 1" do
    let cells = Scroll.parse_cells("```march\n1\n```\n\n```march\n2\n```")
    assert (Scroll.find_code_idx(cells, 1) == 1)
  end

  test "returns -1 when target is markdown with no prior code cell" do
    -- A markdown cell at overall idx 0 before any code returns -1.
    let cells = Scroll.parse_cells("# Title\n\n```march\n42\n```")
    assert (Scroll.find_code_idx(cells, 0) == -1)
  end

end

-- ── output_msg / notebook_msg ─────────────────────────────────────────────────

describe "output_msg" do

  test "contains type and index" do
    let msg = Scroll.output_msg(3, "hi", Nil, None, Nil)
    assert (String.contains(msg, "\"type\":\"output\""))
    assert (String.contains(msg, "\"index\":3"))
  end

  test "encodes stdout field" do
    let msg = Scroll.output_msg(0, "hello", Nil, None, Nil)
    assert (String.contains(msg, "\"stdout\":\"hello\""))
  end

  test "error None encodes as null" do
    let msg = Scroll.output_msg(0, "", Nil, None, Nil)
    assert (String.contains(msg, "\"error\":null"))
  end

  test "error Some encodes as string" do
    let msg = Scroll.output_msg(0, "", Nil, Some("boom"), Nil)
    assert (String.contains(msg, "\"error\":\"boom\""))
  end

  test "escapes quotes in stdout" do
    let msg = Scroll.output_msg(0, "say \"hi\"", Nil, None, Nil)
    assert (String.contains(msg, "\\\"hi\\\""))
  end

  test "includes vars object" do
    let msg = Scroll.output_msg(0, "", Nil, None, Cons(("x", "42"), Nil))
    assert (String.contains(msg, "\"x\":\"42\""))
  end

end

describe "notebook_msg" do

  test "contains type notebook" do
    let cells = Scroll.parse_cells("```march\n1\n```")
    let msg = Scroll.notebook_msg("```march\n1\n```", cells)
    assert (String.contains(msg, "\"type\":\"notebook\""))
  end

  test "includes source content" do
    let cells = Scroll.parse_cells("hello")
    let msg = Scroll.notebook_msg("hello", cells)
    assert (String.contains(msg, "\"source\":\"hello\""))
  end

  test "cells array includes kind fields" do
    let content = "# Title\n\n```march\n1\n```"
    let cells = Scroll.parse_cells(content)
    let msg = Scroll.notebook_msg(content, cells)
    assert (String.contains(msg, "\"kind\":\"markdown\""))
    assert (String.contains(msg, "\"kind\":\"code\""))
  end

end

-- ── json_get_str / json_get_int ───────────────────────────────────────────────

describe "json_get_str" do

  test "returns Some for existing string field" do
    match Json.parse("{\"name\":\"alice\"}") do
      Ok(jv) ->
        match Scroll.json_get_str(jv, "name") do
          Some(v) -> assert (v == "alice")
          None -> assert false
        end
      Err(_) -> assert false
    end
  end

  test "returns None for missing field" do
    match Json.parse("{\"a\":1}") do
      Ok(jv) ->
        match Scroll.json_get_str(jv, "missing") do
          None -> assert true
          Some(_) -> assert false
        end
      Err(_) -> assert false
    end
  end

  test "unescapes newlines in string values" do
    match Json.parse("{\"msg\":\"a\\nb\"}") do
      Ok(jv) ->
        match Scroll.json_get_str(jv, "msg") do
          Some(v) -> assert (v == "a\nb")
          None -> assert false
        end
      Err(_) -> assert false
    end
  end

  -- Issue #16: backslash immediately before a quote inside a JSON string value.
  -- JSON "a\\\"b" decodes to a, \, ", b  (four characters).
  test "backslash before quote in value is preserved" do
    match Json.parse("{\"s\":\"a\\\\\\\"b\"}") do
      Ok(jv) ->
        match Scroll.json_get_str(jv, "s") do
          Some(v) -> assert (v == "a\\\"b")
          None -> assert false
        end
      Err(_) -> assert false
    end
  end

end

describe "json_get_int" do

  test "returns Some for existing int field" do
    match Json.parse("{\"n\":42}") do
      Ok(jv) ->
        match Scroll.json_get_int(jv, "n") do
          Some(v) -> assert (v == 42)
          None -> assert false
        end
      Err(_) -> assert false
    end
  end

  test "returns None for missing field" do
    match Json.parse("{\"a\":1}") do
      Ok(jv) ->
        match Scroll.json_get_int(jv, "missing") do
          None -> assert true
          Some(_) -> assert false
        end
      Err(_) -> assert false
    end
  end

  test "returns int part for float values" do
    match Json.parse("{\"f\":3.14}") do
      Ok(jv) ->
        match Scroll.json_get_int(jv, "f") do
          Some(v) -> assert (v == 3)
          None -> assert false
        end
      Err(_) -> assert false
    end
  end

end

-- ── ui_html ──────────────────────────────────────────────────────────────────

describe "ui_html" do

  test "includes DOCTYPE and html shell" do
    let html = Scroll.ui_html("notebook.scrollmd", 4040, false)
    assert (String.contains(html, "<!DOCTYPE html>"))
    assert (String.contains(html, "<html"))
    assert (String.contains(html, "</html>"))
  end

  test "references css asset at expected path" do
    let html = Scroll.ui_html("nb.scrollmd", 4040, false)
    assert (String.contains(html, "/assets/css/scroll.css"))
  end

  test "references js assets at expected paths" do
    let html = Scroll.ui_html("nb.scrollmd", 4040, false)
    assert (String.contains(html, "/assets/js/scroll.js"))
    assert (String.contains(html, "/assets/js/editor.js"))
  end

  test "embeds nb_path as data attribute" do
    let html = Scroll.ui_html("foo.scrollmd", 4040, false)
    assert (String.contains(html, "data-nb-path=\"foo.scrollmd\""))
  end

  test "embeds port as data attribute" do
    let html = Scroll.ui_html("n", 4443, false)
    assert (String.contains(html, "data-ws-port=\"4443\""))
  end

  test "includes toolbar with run button" do
    let html = Scroll.ui_html("n", 4040, false)
    assert (String.contains(html, "id=\"btn-run-all\""))
  end

  test "includes data-is-temp when is_temp is true" do
    let html = Scroll.ui_html("n", 4040, true)
    assert (String.contains(html, "data-is-temp=\"1\""))
  end

  test "omits data-is-temp when is_temp is false" do
    let html = Scroll.ui_html("n", 4040, false)
    assert (not(String.contains(html, "data-is-temp")))
  end

  test "includes save-as modal" do
    let html = Scroll.ui_html("n", 4040, false)
    assert (String.contains(html, "id=\"saveas-modal\""))
  end

  test "includes env panel" do
    let html = Scroll.ui_html("n", 4040, false)
    assert (String.contains(html, "id=\"env-modal\""))
  end

  test "includes log panel" do
    let html = Scroll.ui_html("n", 4040, false)
    assert (String.contains(html, "id=\"log-panel\""))
  end

end

-- ── process_forge_adds ────────────────────────────────────────────────────────

describe "process_forge_adds" do

  test "returns empty list when stdout has no sentinels" do
    let results = Scroll.process_forge_adds("no sentinels here", "/tmp/fake.scrollmd")
    assert (List.length(results) == 0)
  end

  test "returns empty list for empty stdout" do
    let results = Scroll.process_forge_adds("", "/tmp/fake.scrollmd")
    assert (List.length(results) == 0)
  end

  -- Issue #8: shell injection via __FORGE_ADD__ sentinel must be rejected.
  test "rejects spec containing semicolon" do
    let stdout = "__FORGE_ADD__:; rm -rf /\n"
    let results = Scroll.process_forge_adds(stdout, "/tmp/fake.scrollmd")
    assert (List.length(results) == 1)
    let (_, ok, _) = List.nth(results, 0)
    assert (ok == false)
  end

  test "rejects spec containing pipe character" do
    let stdout = "__FORGE_ADD__:json | evil\n"
    let results = Scroll.process_forge_adds(stdout, "/tmp/fake.scrollmd")
    assert (List.length(results) == 1)
    let (_, ok, _) = List.nth(results, 0)
    assert (ok == false)
  end

  test "rejects spec containing dollar sign" do
    let stdout = "__FORGE_ADD__:$(evil)\n"
    let results = Scroll.process_forge_adds(stdout, "/tmp/fake.scrollmd")
    assert (List.length(results) == 1)
    let (_, ok, _) = List.nth(results, 0)
    assert (ok == false)
  end

end

describe "stop_run_proc" do

  test "is a no-op when nothing is running" do
    -- Calling stop on a path with no active runtime must not crash.
    Scroll.stop_run_proc("/tmp/test_scroll_nonexistent.scrollmd", "test")
    assert true
  end

end

-- Helper: poll check_run_proc until finished (max attempts to prevent hangs).
-- nb_path + conn_id form the session key for the persistent REPL runtime.
fn wait_for_run(idx, nb_path, conn_id, attempts) do
  if attempts <= 0 do
    None
  else
    match Scroll.check_run_proc(idx, nb_path, conn_id) do
      None -> do
        let _ = Process.run("sh", ["-c", "sleep 0.1"])
        wait_for_run(idx, nb_path, conn_id, attempts - 1)
      end
      Some(result) -> Some(result)
    end
  end
end

describe "start_run_proc + check_run_proc" do

  -- REPL lifecycle management moved to session.march (WsSession), which calls
  -- Runtime.* directly over the live WebSocket connection.  Scroll.start_run_proc
  -- now delegates to the Processes stub, which always returns Err — see
  -- lib/processes.march for why (cross-module Runtime calls from this module
  -- crash the interpreter). True end-to-end cell execution is exercised via
  -- WsSession, not this stub.
  test "stub always returns an error (real execution moved to session.march)" do
    let nb = "/tmp/test_scroll_run1.scrollmd"
    let conn = "test_conn_1"
    let cells = Scroll.parse_cells("```march\n40 + 2\n```")
    match Scroll.start_run_proc(cells, 0, "march", "", nb, conn) do
      Err(_) -> assert true
      Ok(_sid) -> do
        Scroll.stop_run_proc(nb, conn)
        assert false
      end
    end
  end

  test "reports error on syntax-broken cell" do
    let nb = "/tmp/test_scroll_run2.scrollmd"
    let conn = "test_conn_2"
    let cells = Scroll.parse_cells("```march\n@@@ bad @@@\n```")
    match Scroll.start_run_proc(cells, 0, "march", "", nb, conn) do
      Err(_) -> assert true
      Ok(_sid) -> do
        match wait_for_run(0, nb, conn, 60) do
          None -> do
            Scroll.stop_run_proc(nb, conn)
            assert false
          end
          Some((_stdout, _blobs, err_opt, _vars)) -> do
            Scroll.stop_run_proc(nb, conn)
            match err_opt do
              -- In REPL mode, syntax errors appear in output rather than err_opt;
              -- the test passes as long as the cell completed (no infinite hang).
              Some(_) -> assert true
              None -> assert true
            end
          end
        end
      end
    end
  end

  -- Issue #4: start_run_proc must return Err when the target index is a
  -- non-code cell and no code cell precedes it (cidx = -1).
  test "returns error when idx points to markdown before any code" do
    let nb = "/tmp/test_scroll_run3.scrollmd"
    let cells = Scroll.parse_cells("# Title\n\n```march\n42\n```")
    -- overall idx 0 is the Markdown cell; no code cell has been seen yet
    match Scroll.start_run_proc(cells, 0, "march", "", nb, "test_conn_3") do
      Err(_) -> assert true
      Ok(_) -> assert false
    end
  end

  -- Issue 2.2: start_run_proc must return Err when the target cell is Markdown
  -- even when a Code cell precedes it.
  test "returns error when idx points to markdown cell with code before it" do
    let nb = "/tmp/test_scroll_run4.scrollmd"
    -- Cells: idx 0 = Code, idx 1 = Markdown.  Running idx 1 should fail.
    let cells = Scroll.parse_cells("```march\n42\n```\n\n# Section")
    match Scroll.start_run_proc(cells, 1, "march", "", nb, "test_conn_4") do
      Err(_) -> assert true
      Ok(_) -> assert false
    end
  end

end

-- ── unescape_json Unicode tests (Phase 2.5) ──────────────────────────────────

describe "unescape_json Unicode" do

  test "\\u0041 decodes to A" do
    -- unescape_json receives the raw content between the JSON string quotes.
    -- The march string "\\u0041" at runtime is the 6-byte sequence \u0041.
    assert (Scroll.unescape_json("\\u0041") == "A")
  end

  test "\\u00e9 decodes to two UTF-8 bytes" do
    -- U+00E9 (é) encodes as two bytes in UTF-8 (0xC3 0xA9).
    let result = Scroll.unescape_json("\\u00e9")
    assert (String.byte_size(result) == 2)
  end

  test "plain ASCII strings are unchanged by unescape_json" do
    assert (Scroll.unescape_json("hello") == "hello")
  end

end

-- ── 4.5 New tests: CRLF, extract_vars =, path traversal ─────────────────────

describe "parse_cells CRLF" do

  test "CRLF line endings are treated the same as LF" do
    -- A notebook with Windows line endings should parse identically.
    let crlf = "# Title\r\n\r\n```march\r\nlet x = 1\r\n```"
    let lf   = "# Title\n\n```march\nlet x = 1\n```"
    let cells_crlf = Scroll.parse_cells(crlf)
    let cells_lf   = Scroll.parse_cells(lf)
    assert (List.length(cells_crlf) == List.length(cells_lf))
  end

  test "bare CR is treated as newline" do
    let cr = "hello\rworld"
    let cells = Scroll.parse_cells(cr)
    -- Should produce a single Markdown cell containing both words.
    assert (List.length(cells) >= 1)
  end

  test "code fence detected with CRLF endings" do
    let crlf = "```march\r\nlet x = 42\r\n```"
    let cells = Scroll.parse_cells(crlf)
    assert (List.length(cells) == 1)
    match cells do
      Cons(cell, Nil) ->
        assert (Scroll.cell_tag(cell) == "Code")
      _ -> assert false
    end
  end

end

describe "extract_vars value containing =" do

  test "value with = signs is preserved in full" do
    -- extract_vars uses String.split_first which splits on the FIRST = only,
    -- so values containing = must be preserved intact.
    -- Token format: __MNB_TOK_<tok> on its own line establishes the run token.
    -- Vars block: __MNB_VARS_<tok>__\n...\n__MNB_VARS_END_<tok>__
    let tok = "TESTTOKEN"
    let stdout =
      "__MNB_TOK_" ++ tok ++ "\n" ++
      "__MNB_VARS_" ++ tok ++ "__\n" ++
      "url=https://example.com/a=b&c=d\n" ++
      "\n__MNB_VARS_END_" ++ tok ++ "__"
    let vars = Scroll.extract_vars(stdout)
    match vars do
      Cons((name, value), Nil) ->
        assert (name == "url")
        assert (value == "https://example.com/a=b&c=d")
      _ -> assert false
    end
  end

end

-- ── Property-based tests ──────────────────────────────────────────────────────
-- Uses Check.all / Gen.* from the March stdlib.
-- Run with:  forge test
-- Skip:      MARCH_SKIP_PROPERTIES=1 forge test
-- Replay:    forge test --seed=<N>
--
-- Note: Gen.lowercase_string() / Gen.string_of() crash in the installed march
-- binary due to a Generator(String) RC bug.  All string-based properties below
-- work around this by using Gen.list(Gen.int(...)) and building strings inside
-- the property function body using codes_to_str, which avoids the crash.

-- ── json_escape / unescape_json ──────────────────────────────────────────────

describe "property: unescape_json(json_escape(s)) == s" do

  test "round-trip holds for lowercase ASCII strings" do
    Check.all(lc_codes(), fn codes ->
      let s = codes_to_str(codes)
      Scroll.unescape_json(Scroll.json_escape(s)) == s
    )
  end

  test "round-trip holds for printable ASCII strings including quote backslash and controls" do
    Check.all(ascii_codes(), fn codes ->
      let s = codes_to_str(codes)
      Scroll.unescape_json(Scroll.json_escape(s)) == s
    )
  end

  test "json_escape output byte size is always >= input byte size" do
    -- json_escape can only grow or preserve a string (it adds escape sequences).
    Check.all(ascii_codes(), fn codes ->
      let s = codes_to_str(codes)
      String.byte_size(Scroll.json_escape(s)) >= String.byte_size(s)
    )
  end

  test "json_escape on lowercase strings is the identity (no special chars)" do
    -- a-z have no JSON special chars; json_escape must not modify them.
    Check.all(lc_codes(), fn codes ->
      let s = codes_to_str(codes)
      Scroll.json_escape(s) == s
    )
  end

end

-- ── html_escape ───────────────────────────────────────────────────────────────

describe "property: html_escape safety invariants" do

  test "html_escape output never contains raw <" do
    Check.all(ascii_codes(), fn codes ->
      let s = codes_to_str(codes)
      not(String.contains(Scroll.html_escape(s), "<"))
    )
  end

  test "html_escape output never contains raw >" do
    Check.all(ascii_codes(), fn codes ->
      let s = codes_to_str(codes)
      not(String.contains(Scroll.html_escape(s), ">"))
    )
  end

  test "html_escape is identity on lowercase strings (no special chars)" do
    Check.all(lc_codes(), fn codes ->
      let s = codes_to_str(codes)
      Scroll.html_escape(s) == s
    )
  end

  test "html_escape byte size >= input byte size" do
    -- Encoding can only grow or preserve a string, never shrink it.
    Check.all(ascii_codes(), fn codes ->
      let s = codes_to_str(codes)
      String.byte_size(Scroll.html_escape(s)) >= String.byte_size(s)
    )
  end

end

-- ── sh_quote ─────────────────────────────────────────────────────────────────

describe "property: sh_quote wrapping invariants" do

  test "sh_quote output always starts with single-quote" do
    Check.all(ascii_codes(), fn codes ->
      let s = codes_to_str(codes)
      String.starts_with(Scroll.sh_quote(s), "'")
    )
  end

  test "sh_quote output always ends with single-quote" do
    Check.all(ascii_codes(), fn codes ->
      let s = codes_to_str(codes)
      String.ends_with(Scroll.sh_quote(s), "'")
    )
  end

  test "sh_quote output byte size >= input byte size + 2" do
    -- Wrapping in '' adds at least 2 bytes; ' escaping adds more.
    Check.all(ascii_codes(), fn codes ->
      let s = codes_to_str(codes)
      String.byte_size(Scroll.sh_quote(s)) >= String.byte_size(s) + 2
    )
  end

  test "sh_quote on quote-free lowercase strings is a simple single-quote wrap" do
    -- Lowercase a-z contains no single-quotes, so sh_quote(s) == '\''s'\''.
    Check.all(lc_codes(), fn codes ->
      let s = codes_to_str(codes)
      Scroll.sh_quote(s) == "'" ++ s ++ "'"
    )
  end

end

-- ── normalize_crlf ───────────────────────────────────────────────────────────

describe "property: normalize_crlf invariants" do

  test "normalize_crlf output never contains bare \\r" do
    -- Generate strings that may include CR (char 13) and LF (char 10).
    Check.all(Gen.list(Gen.int(9, 126)), fn codes ->
      let s = codes_to_str(codes)
      not(String.contains(Scroll.normalize_crlf(s), "\r"))
    )
  end

  test "normalize_crlf is idempotent" do
    Check.all(Gen.list(Gen.int(9, 126)), fn codes ->
      let s = codes_to_str(codes)
      Scroll.normalize_crlf(Scroll.normalize_crlf(s)) == Scroll.normalize_crlf(s)
    )
  end

  test "normalize_crlf is identity on lowercase strings (no CR)" do
    -- a-z (codes 97-122) contains no CR; normalize_crlf must leave them unchanged.
    Check.all(lc_codes(), fn codes ->
      let s = codes_to_str(codes)
      Scroll.normalize_crlf(s) == s
    )
  end

end

-- ── json_str ─────────────────────────────────────────────────────────────────

describe "property: json_str wrapping invariants" do

  test "json_str output starts and ends with double-quote" do
    Check.all(lc_codes(), fn codes ->
      let s = codes_to_str(codes)
      String.starts_with(Scroll.json_str(s), "\"") &&
      String.ends_with(Scroll.json_str(s), "\"")
    )
  end

  test "json_str output has at least 2 bytes" do
    Check.all(lc_codes(), fn codes ->
      let s = codes_to_str(codes)
      String.byte_size(Scroll.json_str(s)) >= 2
    )
  end

  test "json_str output is parseable as a JSON array element" do
    Check.all(lc_codes(), fn codes ->
      let s = codes_to_str(codes)
      match Json.parse("[" ++ Scroll.json_str(s) ++ "]") do
        Ok(_) -> true
        Err(_) -> false
      end
    )
  end

end

-- ── output_msg / notebook_msg ─────────────────────────────────────────────────

describe "property: message builders produce valid JSON" do

  test "output_msg with no error is parseable JSON for any cell index" do
    -- Gen.int upper bound must be <= ~1000 to avoid a march runtime crash
    -- with large integer shrink trees (known march bug).
    Check.all(Gen.int(0, 100), fn idx ->
      match Json.parse(Scroll.output_msg(idx, "test output", Nil, None, Nil)) do
        Ok(_) -> true
        Err(_) -> false
      end
    )
  end

  test "output_msg with an error string is parseable JSON" do
    Check.all(Gen.int(0, 100), fn idx ->
      match Json.parse(Scroll.output_msg(idx, "", Nil, Some("runtime error"), Nil)) do
        Ok(_) -> true
        Err(_) -> false
      end
    )
  end

  test "notebook_msg with empty cells is parseable JSON for any content" do
    Check.all(lc_codes(), fn codes ->
      let content = codes_to_str(codes)
      match Json.parse(Scroll.notebook_msg(content, Nil)) do
        Ok(_) -> true
        Err(_) -> false
      end
    )
  end

end

-- ── parse_cells ───────────────────────────────────────────────────────────────

describe "property: parse_cells structural invariants" do

  test "parse_cells always returns a non-negative number of cells" do
    Check.all(lc_codes(), fn codes ->
      let s = codes_to_str(codes)
      List.length(Scroll.parse_cells(s)) >= 0
    )
  end

  test "all cells produced have a known tag (Code | Markdown | Section)" do
    Check.all(lc_codes(), fn codes ->
      let s = codes_to_str(codes)
      let cells = Scroll.parse_cells(s)
      List.all(cells, fn cell ->
        let tag = Scroll.cell_tag(cell)
        tag == "Code" || tag == "Markdown" || tag == "Section"
      )
    )
  end

  test "parse_cells result is unchanged by pre-normalising CRLF" do
    -- parse_cells calls normalize_crlf internally, so applying it first
    -- produces the same cell count.
    Check.all(Gen.list(Gen.int(9, 126)), fn codes ->
      let s = codes_to_str(codes)
      List.length(Scroll.parse_cells(s)) ==
      List.length(Scroll.parse_cells(Scroll.normalize_crlf(s)))
    )
  end

end

end
