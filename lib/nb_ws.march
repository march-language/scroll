-- nb_ws.march — WebSocket message handler and receive loop.
--
-- Dispatches JSON messages from the browser to the appropriate sub-system:
--   load / save      → file I/O
--   run / poll_run / stop_run  → NbProcess code-cell execution
--   start_server / stop_server / read_server → NbProcess server-cell management
--
-- Public API (fn):
--   ws_loop/3 : receive and handle WebSocket frames until the connection closes

mod NbWs do

import NbCells
import NbRunner
import NbProcess
import NbJson

-- ── Internal helpers ──────────────────────────────────────────────────────────

pfn err_frame(msg) do
  TextFrame("{\"type\":\"error\",\"message\":" ++ json_str(msg) ++ "}")
end

-- ── Message dispatcher ────────────────────────────────────────────────────────

pfn handle_ws_msg(msg, nb_path, march_bin, socket) do
  match Json.parse(msg) do
    Err(_) ->
      WebSocket.send_frame(socket, err_frame("invalid JSON"))
    Ok(jv) ->
      match json_get_str(jv, "type") do
        None ->
          WebSocket.send_frame(socket, err_frame("missing type field"))

        Some("load") ->
          match File.read(nb_path) do
            Err(e) ->
              WebSocket.send_frame(socket, err_frame(to_string(e)))
            Ok(content) ->
              let cells = parse_cells(content)
              WebSocket.send_frame(socket, TextFrame(
                notebook_msg(content, cells)
              ))
          end

        Some("save") ->
          match json_get_str(jv, "content") do
            None ->
              WebSocket.send_frame(socket, err_frame("missing content"))
            Some(content) ->
              match File.write(nb_path, content) do
                Err(e) ->
                  WebSocket.send_frame(socket, err_frame(to_string(e)))
                Ok(_) ->
                  WebSocket.send_frame(socket, TextFrame("{\"type\":\"saved\"}"))
              end
          end

        Some("run") ->
          let idx_opt = json_get_int(jv, "index")
          match idx_opt do
            None ->
              WebSocket.send_frame(socket, err_frame("missing index"))
            Some(idx) ->
              match File.read(nb_path) do
                Err(e) ->
                  WebSocket.send_frame(socket, err_frame(to_string(e)))
                Ok(content) ->
                  let cells = parse_cells(content)
                  match NbProcess.start_run_proc(cells, idx, march_bin) do
                    Err(msg) ->
                      WebSocket.send_frame(socket, TextFrame(output_msg(idx, "", Some(msg), Nil)))
                    Ok(_pid) ->
                      WebSocket.send_frame(socket, TextFrame(
                        "{\"type\":\"running\",\"index\":" ++ String.from_int(idx) ++ "}"
                      ))
                  end
              end
          end

        Some("poll_run") ->
          match json_get_int(jv, "index") do
            None ->
              WebSocket.send_frame(socket, err_frame("missing index"))
            Some(idx) ->
              match NbProcess.check_run_proc(idx) do
                None ->
                  WebSocket.send_frame(socket, TextFrame(
                    "{\"type\":\"still_running\",\"index\":" ++ String.from_int(idx) ++ "}"
                  ))
                Some((out, err_opt, vars)) ->
                  -- Process __FORGE_ADD__ sentinels and strip them from output
                  let add_results = NbRunner.process_forge_adds(out, nb_path)
                  let clean_out = NbRunner.strip_forge_adds(out)
                  WebSocket.send_frame(socket, TextFrame(output_msg(idx, clean_out, err_opt, vars)))
                  -- Send dep_added/dep_error messages for each Forge.add() call
                  List.each(add_results, fn result ->
                    let (name, ok, message) = result
                    if ok do
                      WebSocket.send_frame(socket, TextFrame(
                        "{\"type\":\"dep_added\",\"name\":" ++ json_str(name) ++
                        ",\"status\":\"ok\",\"message\":" ++ json_str(message) ++ "}"
                      ))
                    else
                      WebSocket.send_frame(socket, TextFrame(
                        "{\"type\":\"dep_error\",\"name\":" ++ json_str(name) ++
                        ",\"message\":" ++ json_str(message) ++ "}"
                      ))
                    end
                  )
              end
          end

        Some("stop_run") ->
          match json_get_int(jv, "index") do
            None ->
              WebSocket.send_frame(socket, err_frame("missing index"))
            Some(idx) ->
              NbProcess.stop_run_proc(idx)
              WebSocket.send_frame(socket, TextFrame(output_msg(idx, "", Some("interrupted"), Nil)))
          end

        Some("start_server") ->
          match json_get_int(jv, "index") do
            None ->
              WebSocket.send_frame(socket, err_frame("missing index"))
            Some(idx) ->
              match File.read(nb_path) do
                Err(e) ->
                  WebSocket.send_frame(socket, err_frame(to_string(e)))
                Ok(content) ->
                  let cells = parse_cells(content)
                  match nth_cell(cells, idx) do
                    None ->
                      WebSocket.send_frame(socket, err_frame("cell not found"))
                    Some(ServerCell(src)) ->
                      match NbProcess.start_server_proc(src, idx, march_bin) do
                        Err(msg) ->
                          WebSocket.send_frame(socket, TextFrame(
                            "{\"type\":\"server_error\",\"index\":" ++ String.from_int(idx) ++
                            ",\"message\":" ++ json_str(msg) ++ "}"
                          ))
                        Ok(pid) ->
                          WebSocket.send_frame(socket, TextFrame(
                            "{\"type\":\"server_started\",\"index\":" ++ String.from_int(idx) ++
                            ",\"pid\":" ++ json_str(pid) ++ "}"
                          ))
                      end
                    Some(_) ->
                      WebSocket.send_frame(socket, err_frame("cell is not a server cell"))
                  end
              end
          end

        Some("stop_server") ->
          match json_get_int(jv, "index") do
            None ->
              WebSocket.send_frame(socket, err_frame("missing index"))
            Some(idx) ->
              -- stop_server_proc also clears the server log
              NbProcess.stop_server_proc(idx)
              WebSocket.send_frame(socket, TextFrame(
                "{\"type\":\"server_stopped\",\"index\":" ++ String.from_int(idx) ++ "}"
              ))
          end

        Some("read_server") ->
          match json_get_int(jv, "index") do
            None ->
              WebSocket.send_frame(socket, err_frame("missing index"))
            Some(idx) ->
              let content = NbProcess.read_server_log(idx)
              -- server_is_running cleans up the vault entry when the process is dead
              let running = NbProcess.server_is_running(idx)
              WebSocket.send_frame(socket, TextFrame(
                "{\"type\":\"server_output\",\"index\":" ++ String.from_int(idx) ++
                ",\"content\":" ++ json_str(content) ++
                ",\"running\":" ++ (if running do "true" else "false" end) ++ "}"
              ))
          end

        Some(other) ->
          WebSocket.send_frame(socket, err_frame("unknown type: " ++ json_escape(other)))
      end
  end
end

-- ── Receive loop ──────────────────────────────────────────────────────────────

fn ws_loop(socket, nb_path, march_bin) do
  match WebSocket.recv(socket) do
    TextFrame(msg) ->
      handle_ws_msg(msg, nb_path, march_bin, socket)
      ws_loop(socket, nb_path, march_bin)
    Ping ->
      WebSocket.send_frame(socket, Pong)
      ws_loop(socket, nb_path, march_bin)
    Pong ->
      ws_loop(socket, nb_path, march_bin)
    Close(code, reason) ->
      WebSocket.close(socket, code, reason)
    _ ->
      ws_loop(socket, nb_path, march_bin)
  end
end

end
