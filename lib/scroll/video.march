-- lib/scroll/video.march — Emit video blobs via the __SCROLL_BLOB__ sentinel protocol.
--
-- User code calls these helpers to embed video in the notebook:
--
--   ScrollVideo.mp4(b64_data)  -- embed an MP4 video
--   ScrollVideo.webm(b64_data) -- embed a WebM video
--   ScrollVideo.show(mime, b64)-- embed any video MIME type
--
-- The browser renders the blob as `<video controls src="data:<mime>;base64,<b64>">`.

mod ScrollVideo do
  needs IO.Console

doc "Build the raw sentinel string for a video blob (for testing / composing)."
fn make_sentinel(mime : String, b64 : String) : String do
  "__SCROLL_BLOB__:" ++ mime ++ ":" ++ b64 ++ "\n__SCROLL_BLOB_END__\n"
end

doc """
Embed video with the given MIME type in the notebook output.

`b64` must be a valid base64-encoded representation of the video bytes.
The browser renders the result as `<video controls src="data:<mime>;base64,<b64>">`.

## Examples

    march> ScrollVideo.show("video/mp4", "AAAAFG...")
    ()
"""
fn show(mime : String, b64 : String) : () do
  print(make_sentinel(mime, b64))
end

doc "Embed an MP4 video. `b64` is the base64-encoded MP4 bytes."
fn mp4(b64 : String) : () do show("video/mp4", b64) end

doc "Embed a WebM video. `b64` is the base64-encoded WebM bytes."
fn webm(b64 : String) : () do show("video/webm", b64) end

end
