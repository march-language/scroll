mod Session do

  -- session.march — WebSocket message handler and receive loop.
  --
  -- Dispatches JSON messages from the browser to the appropriate sub-system:
  --   load / save / save_as      → file I/O
  --   run / poll_run / stop_run  → Runtime (directly — no Processes hop)
  --   read_log                   → DebugLog
  --
  -- Each WebSocket connection is identified by a unique conn_id (generated in
  -- scroll.march when the upgrade happens).  The conn_id is threaded through
  -- ws_loop and all Runtime calls so each browser tab owns an isolated REPL.
  -- When the connection closes, the REPL for that conn_id is stopped.
  --
  -- NOTE: Runtime.* calls must be made from session.march directly.  Calling
  -- them from processes.march crashes the March interpreter with the new JIT
  -- binary (cross-module dispatch bug; see memory/feedback_march_crossmodule_bug.md).
  --
  -- Public API (fn):
  --   ws_loop/4 : receive and handle WebSocket frames until the connection closes
  import Cells
  import Protocol
  import DebugLog
  import Runtime

  -- Session ID: combines the notebook path and the per-WebSocket connection ID
  -- so each browser tab gets its own isolated REPL process.
  pfn rt_session_id(nb_path, conn_id) do nb_path ++ ":" ++ conn_id end

  -- ── Inline blob parser (avoids cross-module complex-return JIT bug) ──────────
  -- The new JIT binary (Apr 22 18:38) hangs on cross-module calls that return
  -- tuples or lists.  BlobParser.parse returns (String, List) — triggers the bug.
  -- Inlining the logic here (within-module) avoids the cross-module dispatch.
  pfn blob_sentinel_start() do "__SCROLL_BLOB__:" end
  pfn blob_sentinel_end()   do "__SCROLL_BLOB_END__\n" end

  pfn parse_blob_header(header) do
    match String.split_first(header, ":") do
      None -> None
      Some((mime, b64)) ->
        if String.is_empty(mime) do None
        else Some((mime, b64))
        end
    end
  end

  pfn do_parse_blobs(remaining, text_acc, blobs_acc) do
    match String.split_first(remaining, blob_sentinel_start()) do
      None -> (text_acc ++ remaining, List.reverse(blobs_acc))
      Some((before, after)) ->
        match String.split_first(after, "\n") do
          None ->
            (text_acc ++ before ++ blob_sentinel_start() ++ after, List.reverse(blobs_acc))
          Some((header, rest_after_header)) ->
            match String.split_first(rest_after_header, blob_sentinel_end()) do
              None ->
                (text_acc ++ before ++ blob_sentinel_start() ++ header ++ "\n" ++ rest_after_header,
                 List.reverse(blobs_acc))
              Some((between, after_end)) ->
                if not(String.is_empty(between)) do
                  let kept = blob_sentinel_start() ++ header ++ "\n" ++ between ++ blob_sentinel_end()
                  do_parse_blobs(after_end, text_acc ++ before ++ kept, blobs_acc)
                else
                  match parse_blob_header(header) do
                    None ->
                      let kept = blob_sentinel_start() ++ header ++ "\n" ++ blob_sentinel_end()
                      do_parse_blobs(after_end, text_acc ++ before ++ kept, blobs_acc)
                    Some((mime, b64)) ->
                      if String.byte_size(b64) > 11184812 do
                        let mb = String.from_int(String.byte_size(b64) / 1024 / 1024)
                        let err = "[blob too large: " ++ mb ++ " MB — max 8 MB]\n"
                        do_parse_blobs(after_end, text_acc ++ before ++ err, blobs_acc)
                      else
                        do_parse_blobs(after_end, text_acc ++ before,
                                       Cons((mime, b64), blobs_acc))
                      end
                  end
                end
            end
        end
    end
  end

  -- Parse raw stdout for __SCROLL_BLOB__ blocks.  Returns (clean_text, blobs).
  pfn parse_blobs(raw) do
    do_parse_blobs(raw, "", Nil)
  end

  -- Strip __FORGE_ADD__: sentinel lines from cell output (inline Runner.strip_forge_adds).
  pfn strip_forge_add_lines(output) do
    let lines = String.split(output, "\n")
    let filtered = List.filter(lines, fn line ->
      not(String.starts_with(line, "__FORGE_ADD__:"))
    )
    String.join(filtered, "\n")
  end

  -- Extract variable bindings from the REPL-mode output.
  -- REPL mode does not emit __MNB_VARS__ blocks, so this always returns Nil.
  pfn extract_vars_repl(_stdout) do Nil end

  -- Send a dep_added/dep_error frame for one Forge.add() result tuple.
  fn send_dep_result(socket, result) do
    let (name, ok, message) = result
    if ok do
      WebSocket.send_frame(socket, TextFrame("{\"type\":\"dep_added\",\"name\":" ++ json_str(name) ++ ",\"status\":\"ok\",\"message\":" ++ json_str(message) ++ "}"))
    else
      WebSocket.send_frame(socket, TextFrame("{\"type\":\"dep_error\",\"name\":" ++ json_str(name) ++ ",\"message\":" ++ json_str(message) ++ "}"))
    end
  end

  -- ── Receive loop ──────────────────────────────────────────────────────────────
  fn ws_loop(socket, nb_path, march_bin, conn_id) do
    match WebSocket.recv(socket) do
    TextFrame(msg) -> do
      let new_path = handle_ws_msg(msg, nb_path, march_bin, socket, conn_id)
      ws_loop(socket, new_path, march_bin, conn_id)
    end
    Ping -> do
      WebSocket.send_frame(socket, Pong)
      ws_loop(socket, nb_path, march_bin, conn_id)
    end
    Pong -> ws_loop(socket, nb_path, march_bin, conn_id)
    Close(code, reason) -> do
      -- Clean up the REPL for this connection when the browser tab closes.
      let _ = Runtime.stop_runtime(rt_session_id(nb_path, conn_id))
      WebSocket.close(socket, code, reason)
    end
    _ -> ws_loop(socket, nb_path, march_bin, conn_id)
    end
  end

  -- ── Internal helpers ──────────────────────────────────────────────────────────
  pfn err_frame(msg) do
    TextFrame("{\"type\":\"error\",\"message\":" ++ json_str(msg) ++ "}")
  end

  -- ── Message dispatcher ────────────────────────────────────────────────────────
  -- Returns the (possibly updated) nb_path so save_as can change it.
  pfn handle_ws_msg(msg, nb_path, march_bin, socket, conn_id) do
    match Json.parse(msg) do
    Err(_) -> do WebSocket.send_frame(socket, err_frame("invalid JSON")) nb_path end
    Ok(jv) -> do
      match json_get_str(jv, "type") do
      None -> do WebSocket.send_frame(socket, err_frame("missing type field")) nb_path end
      Some("load") -> do
        DebugLog.append("ws", "load")
        match File.read(nb_path) do
        Err(e) -> WebSocket.send_frame(socket, err_frame(to_string(e)))
        Ok(content) -> do
          let cells = parse_cells(content)
          WebSocket.send_frame(socket, TextFrame(notebook_msg(content, cells)))
          -- Pre-spawn the REPL so the first cell run doesn't pay startup cost.
          -- Called directly from session.march to avoid cross-module crash bug.
          let _ = Runtime.start_runtime(rt_session_id(nb_path, conn_id), march_bin, "")
          ()
        end
        end
        nb_path
      end
      Some("save") -> do
        DebugLog.append("ws", "save -> " ++ nb_path)
        match json_get_str(jv, "content") do
        None -> WebSocket.send_frame(socket, err_frame("missing content"))
        Some(content) -> do
          if String.byte_size(content) > 50000000 do
            WebSocket.send_frame(socket, err_frame("notebook too large (> 50 MB)"))
          else
            match File.write(nb_path, content) do
            Err(e) -> WebSocket.send_frame(socket, err_frame(to_string(e)))
            Ok(_) -> WebSocket.send_frame(socket, TextFrame("{\"type\":\"saved\"}"))
            end
          end
        end
        end
        nb_path
      end
      Some("save_as") -> do
        DebugLog.append("ws", "save_as")
        let path_opt = json_get_str(jv, "path")
        let content_opt = json_get_str(jv, "content")
        match (path_opt, content_opt) do
        (None, _) -> do WebSocket.send_frame(socket, err_frame("missing path")) nb_path end
        (_, None) -> do WebSocket.send_frame(socket, err_frame("missing content")) nb_path end
        (Some(new_path), Some("")) -> do WebSocket.send_frame(socket, err_frame("missing content")) nb_path end
        (Some(new_path), Some(content)) -> do
          if String.byte_size(content) > 50000000 do
            WebSocket.send_frame(socket, err_frame("notebook too large (> 50 MB)"))
            nb_path
          else
          let abs_path = if String.starts_with(new_path, "/") do new_path
            else System.cwd() ++ "/" ++ new_path
            end
          let dir = Path.dirname(abs_path)
          if not(File.exists(dir)) do
            WebSocket.send_frame(socket, err_frame("directory does not exist: " ++ dir))
            nb_path
          else
            match File.write(abs_path, content) do
            Err(e) -> do WebSocket.send_frame(socket, err_frame(to_string(e))) nb_path end
            Ok(_) -> do
              let title = Path.basename(abs_path)
              WebSocket.send_frame(socket, TextFrame(
                "{\"type\":\"saved_as\",\"path\":" ++ json_str(abs_path) ++
                ",\"title\":" ++ json_str(title) ++ "}"
              ))
              abs_path
            end
            end
          end
          end
        end
        end
      end
      Some("run") -> do
        let idx_opt = json_get_int(jv, "index")
        let env_str = match json_get_str(jv, "env") do Some(s) -> s | None -> "" end
        let idx_s = match idx_opt do Some(i) -> String.from_int(i) | None -> "?" end
        DebugLog.append("run", "cell " ++ idx_s)
        match idx_opt do
        None -> WebSocket.send_frame(socket, err_frame("missing index"))
        Some(idx) -> do
          match File.read(nb_path) do
          Err(e) -> WebSocket.send_frame(socket, err_frame(to_string(e)))
          Ok(content) -> do
            let cells = parse_cells(content)
            -- Guard: the target cell must be a Code cell.
            let target_is_code = match Cells.nth_cell(cells, idx) do
              Some(Code(_)) -> true
              _ -> false
            end
            if not(target_is_code) do
              WebSocket.send_frame(socket, TextFrame(
                output_msg(idx, "", [], Some("cell " ++ String.from_int(idx) ++ " is not a code cell"), [])
              ))
            else
              let sid = rt_session_id(nb_path, conn_id)
              match Runtime.start_runtime(sid, march_bin, env_str) do
              Err(emsg) -> do
                WebSocket.send_frame(socket, TextFrame(output_msg(idx, "", [], Some(emsg), [])))
              end
              Ok(proc) -> do
                match Runtime.write_cells(sid, proc, cells, idx) do
                Err(emsg) -> do
                  WebSocket.send_frame(socket, TextFrame(output_msg(idx, "", [], Some(emsg), [])))
                end
                Ok(_skip) -> do
                  WebSocket.send_frame(socket, TextFrame("{\"type\":\"running\",\"index\":" ++ String.from_int(idx) ++ "}"))
                end
                end
              end
              end
            end
          end
          end
        end
        end
        nb_path
      end
      Some("poll_run") -> do
        match json_get_int(jv, "index") do
        None -> WebSocket.send_frame(socket, err_frame("missing index"))
        Some(idx) -> do
          let sid = rt_session_id(nb_path, conn_id)
          -- Use poll_result_ready (returns Bool) to avoid the JIT cross-module bug
          -- with complex ADT return types.  When true, read result via poll_read_*.
          if Runtime.poll_result_ready(sid) do
            let stdout_raw = Runtime.poll_read_stdout(sid)
            let stderr_raw = Runtime.poll_read_stderr(sid)
            -- Use inline helpers instead of BlobParser/Runner cross-module calls.
            -- The new JIT binary hangs on cross-module calls returning complex ADTs
            -- (tuples, lists).  These pfns do the same work within session.march's
            -- module boundary where all types work correctly.
            let (clean_out, blobs) = parse_blobs(stdout_raw)
            let vars = extract_vars_repl(clean_out)
            let clean_out = strip_forge_add_lines(clean_out)
            let add_results = Nil  -- forge add not supported in REPL mode
            -- Surface stderr if present.
            let err_opt = if String.is_empty(stderr_raw) do None else Some(stderr_raw) end
            -- Cap at 64 KB.
            let clean_out =
              if String.byte_size(clean_out) > 65536 do
                String.slice(clean_out, 0, 65536) ++ "\n[output truncated at 64 KB]"
              else clean_out
              end
            WebSocket.send_frame(socket, TextFrame(output_msg(idx, clean_out, blobs, err_opt, vars)))
            List.each(add_results, fn result -> send_dep_result(socket, result))
          else
            let live = match Runtime.poll_live(sid) do
              None -> ""
              Some(s) -> s
            end
            WebSocket.send_frame(socket, TextFrame(
              "{\"type\":\"still_running\",\"index\":" ++ String.from_int(idx) ++
              ",\"live\":" ++ json_str(live) ++ "}"
            ))
          end
        end
        end
        nb_path
      end
      Some("stop_run") -> do
        match json_get_int(jv, "index") do
        None -> WebSocket.send_frame(socket, err_frame("missing index"))
        Some(idx) -> do
          let _ = Runtime.stop_runtime(rt_session_id(nb_path, conn_id))
          WebSocket.send_frame(socket, TextFrame(output_msg(idx, "", [], Some("interrupted"), [])))
        end
        end
        nb_path
      end
      Some("read_log") -> do
        let content = DebugLog.read_all()
        WebSocket.send_frame(socket, TextFrame(
          "{\"type\":\"log_content\",\"content\":" ++ json_str(content) ++
          ",\"path\":" ++ json_str(DebugLog.get_path()) ++ "}"
        ))
        nb_path
      end
      Some(other) -> do
        WebSocket.send_frame(socket, err_frame("unknown type: " ++ json_escape(other)))
        nb_path
      end
      end
    end
    end
  end

end
