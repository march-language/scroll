mod Session do

  -- session.march — WebSocket message handler and receive loop.
  --
  -- Dispatches JSON messages from the browser to the appropriate sub-system:
  --   load / save      → file I/O
  --   run / poll_run / stop_run  → Processes code-cell execution
  --   start_server / stop_server / read_server → Processes server-cell management
  --
  -- Public API (fn):
  --   ws_loop/3 : receive and handle WebSocket frames until the connection closes
  import Cells
  import Protocol

  -- Send a dep_added/dep_error frame for one Forge.add() result tuple.
  fn send_dep_result(socket, result) do
    let (name, ok, message) = result
    if ok do
      WebSocket.send_frame(socket, TextFrame("{\"type\":\"dep_added\",\"name\":" ++ json_str(name) ++ ",\"status\":\"ok\",\"message\":" ++ json_str(message) ++ "}"))
    else
      WebSocket.send_frame(socket, TextFrame("{\"type\":\"dep_error\",\"name\":" ++ json_str(name) ++ ",\"message\":" ++ json_str(message) ++ "}"))
    end
  end

  -- ── Receive loop ──────────────────────────────────────────────────────────────
  fn ws_loop(socket, nb_path, march_bin) do
    match WebSocket.recv(socket) do
    TextFrame(msg) -> do
      handle_ws_msg(msg, nb_path, march_bin, socket)
      ws_loop(socket, nb_path, march_bin)
    end
    Ping -> do
      WebSocket.send_frame(socket, Pong)
      ws_loop(socket, nb_path, march_bin)
    end
    Pong -> ws_loop(socket, nb_path, march_bin)
    Close(code, reason) -> WebSocket.close(socket, code, reason)
    _ -> ws_loop(socket, nb_path, march_bin)
    end
  end

  -- ── Internal helpers ──────────────────────────────────────────────────────────
  pfn err_frame(msg) do
    TextFrame("{\"type\":\"error\",\"message\":" ++ json_str(msg) ++ "}")
  end

  -- ── Message dispatcher ────────────────────────────────────────────────────────
  pfn handle_ws_msg(msg, nb_path, march_bin, socket) do
    match Json.parse(msg) do
    Err(_) -> WebSocket.send_frame(socket, err_frame("invalid JSON"))
    Ok(jv) -> do
      match json_get_str(jv, "type") do
      None -> WebSocket.send_frame(socket, err_frame("missing type field"))
      Some("load") -> do
        match File.read(nb_path) do
        Err(e) -> WebSocket.send_frame(socket, err_frame(to_string(e)))
        Ok(content) -> do
          let cells = parse_cells(content)
          WebSocket.send_frame(socket, TextFrame(notebook_msg(content, cells)))
        end
        end
      end
      Some("save") -> do
        match json_get_str(jv, "content") do
        None -> WebSocket.send_frame(socket, err_frame("missing content"))
        Some(content) -> do
          match File.write(nb_path, content) do
          Err(e) -> WebSocket.send_frame(socket, err_frame(to_string(e)))
          Ok(_) -> WebSocket.send_frame(socket, TextFrame("{\"type\":\"saved\"}"))
          end
        end
        end
      end
      Some("run") -> do
        let idx_opt = json_get_int(jv, "index")
        match idx_opt do
        None -> WebSocket.send_frame(socket, err_frame("missing index"))
        Some(idx) -> do
          match File.read(nb_path) do
          Err(e) -> WebSocket.send_frame(socket, err_frame(to_string(e)))
          Ok(content) -> do
            let cells = parse_cells(content)
            match Processes.start_run_proc(cells, idx, march_bin) do
            Err(msg) -> do
              WebSocket.send_frame(socket, TextFrame(output_msg(idx, "", Some(msg), [])))
            end
            Ok(_pid) -> do
              WebSocket.send_frame(socket, TextFrame("{\"type\":\"running\",\"index\":" ++ String.from_int(idx) ++ "}"))
            end
            end
          end
          end
        end
        end
      end
      Some("poll_run") -> do
        match json_get_int(jv, "index") do
        None -> WebSocket.send_frame(socket, err_frame("missing index"))
        Some(idx) -> do
          match Processes.check_run_proc(idx) do
          None -> do
            WebSocket.send_frame(socket, TextFrame("{\"type\":\"still_running\",\"index\":" ++ String.from_int(idx) ++ "}"))
          end
          Some((out, err_opt, vars)) -> do
            let add_results = Runner.process_forge_adds(out, nb_path)
            let clean_out = Runner.strip_forge_adds(out)
            WebSocket.send_frame(socket, TextFrame(output_msg(idx, clean_out, err_opt, vars)))
            List.each(add_results, fn result -> send_dep_result(socket, result))
          end
          end
        end
        end
      end
      Some("stop_run") -> do
        match json_get_int(jv, "index") do
        None -> WebSocket.send_frame(socket, err_frame("missing index"))
        Some(idx) -> do
          Processes.stop_run_proc(idx)
          WebSocket.send_frame(socket, TextFrame(output_msg(idx, "", Some("interrupted"), [])))
        end
        end
      end
      Some("start_server") -> do
        match json_get_int(jv, "index") do
        None -> WebSocket.send_frame(socket, err_frame("missing index"))
        Some(idx) -> do
          match File.read(nb_path) do
          Err(e) -> WebSocket.send_frame(socket, err_frame(to_string(e)))
          Ok(content) -> do
            let cells = parse_cells(content)
            match nth_cell(cells, idx) do
            None -> WebSocket.send_frame(socket, err_frame("cell not found"))
            Some(ServerCell(src)) -> do
              match Processes.start_server_proc(src, idx, march_bin) do
              Err(msg) -> do
                WebSocket.send_frame(socket, TextFrame("{\"type\":\"server_error\",\"index\":" ++ String.from_int(idx) ++ ",\"message\":" ++ json_str(msg) ++ "}"))
              end
              Ok(pid) -> do
                WebSocket.send_frame(socket, TextFrame("{\"type\":\"server_started\",\"index\":" ++ String.from_int(idx) ++ ",\"pid\":" ++ json_str(pid) ++ "}"))
              end
              end
            end
            Some(_) -> do
              WebSocket.send_frame(socket, err_frame("cell is not a server cell"))
            end
            end
          end
          end
        end
        end
      end
      Some("stop_server") -> do
        match json_get_int(jv, "index") do
        None -> WebSocket.send_frame(socket, err_frame("missing index"))
        Some(idx) -> do
          Processes.stop_server_proc(idx)
          WebSocket.send_frame(socket, TextFrame("{\"type\":\"server_stopped\",\"index\":" ++ String.from_int(idx) ++ "}"))
        end
        end
      end
      Some("read_server") -> do
        match json_get_int(jv, "index") do
        None -> WebSocket.send_frame(socket, err_frame("missing index"))
        Some(idx) -> do
          let content = Processes.read_server_log(idx)
          let running = Processes.server_is_running(idx)
          let running_str = if running do "true" else "false" end
          WebSocket.send_frame(socket, TextFrame("{\"type\":\"server_output\",\"index\":" ++ String.from_int(idx) ++ ",\"content\":" ++ json_str(content) ++ ",\"running\":" ++ running_str ++ "}"))
        end
        end
      end
      Some(other) -> do
        WebSocket.send_frame(socket, err_frame("unknown type: " ++ json_escape(other)))
      end
      end
    end
    end
  end

end
