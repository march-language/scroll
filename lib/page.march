mod Page do

  -- page.march — Server-side HTML shell for the notebook browser UI.
  --
  -- Emits a minimal HTML skeleton that pulls in stylesheet and scripts as
  -- separate assets.  The real content lives under assets/ in the source
  -- tree and is served at /assets/... by the static-asset routes in
  -- scroll.march:
  --   /assets/css/scroll.css   — design system + cell styles
  --   /assets/js/editor.js     — CodeMirror 6 editor module
  --   /assets/js/scroll.js     — WebSocket client, cell rendering, keyboard
  --   /assets/js/purify.min.js — DOMPurify (sanitises HTML cell output)
  --
  -- The nb_path is exposed to JS via a data-* attribute on <body>; the
  -- WebSocket URL is derived from window.location at runtime so we don't
  -- need to bake the port into the page.
  --
  -- nb_path is HTML-escaped before interpolation to prevent injection via
  -- crafted notebook file paths (e.g. paths containing `"` or `<`).
  --
  -- Public API (fn):
  --   ui_html/3 : return the full HTML page as a String

  -- Escape the five HTML metacharacters so nb_path cannot break out of an
  -- attribute value or inject tags.
  pfn html_escape(s) do
    let s = String.replace_all(s, "&", "&amp;")
    let s = String.replace_all(s, "<", "&lt;")
    let s = String.replace_all(s, ">", "&gt;")
    let s = String.replace_all(s, "\"", "&quot;")
    String.replace_all(s, "'", "&#39;")
  end

  fn ui_html(nb_path, port, is_temp) do
    let safe_path = html_escape(nb_path)
    let head_html =
      "<!DOCTYPE html>\n" ++
      "<html lang=\"en\">\n" ++
      "<head>\n" ++
      "<meta charset=\"UTF-8\">\n" ++
      "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n" ++
      "<title>March Notebook — " ++ safe_path ++ "</title>\n" ++
      "<link rel=\"stylesheet\" href=\"/assets/css/scroll.css?v=" ++ String.from_int(System.pid()) ++ "\">\n" ++
      "<script src=\"/assets/js/purify.min.js\"></script>\n" ++
      "<script type=\"importmap\">{\"imports\":{\"@codemirror/state\":\"https://esm.sh/@codemirror/state@6\",\"@codemirror/view\":\"https://esm.sh/@codemirror/view@6\",\"@codemirror/language\":\"https://esm.sh/@codemirror/language@6\",\"@codemirror/commands\":\"https://esm.sh/@codemirror/commands@6\",\"@lezer/highlight\":\"https://esm.sh/@lezer/highlight@1\"}}</script>\n" ++
      "<script type=\"module\" src=\"/assets/js/editor.js\"></script>\n" ++
      "</head>\n"

    let temp_attr = if is_temp do " data-is-temp=\"1\"" else "" end
    let toolbar_html =
      "<body data-nb-path=\"" ++ safe_path ++ "\" data-ws-port=\"" ++ String.from_int(port) ++ "\"" ++ temp_attr ++ ">\n" ++
      "<div id=\"toolbar\">\n" ++
      "<h1 id=\"nb-title\">" ++ safe_path ++ "</h1>\n" ++
      "<button class=\"btn btn-secondary\" id=\"btn-add-md\" title=\"Add Markdown cell\" aria-label=\"Add Markdown cell\"><span class=\"btn-ic\">+ md</span><span class=\"btn-lb\">+ Markdown</span></button>\n" ++
      "<button class=\"btn btn-secondary\" id=\"btn-add-code\" title=\"Add Code cell\" aria-label=\"Add Code cell\"><span class=\"btn-ic\">+ code</span><span class=\"btn-lb\">+ Code</span></button>\n" ++
      "<button class=\"btn btn-secondary\" id=\"btn-add-section\" title=\"Add Section divider\" aria-label=\"Add Section divider\"><span class=\"btn-ic\">+ §</span><span class=\"btn-lb\">+ Section</span></button>\n" ++
      "<button class=\"btn btn-primary\" id=\"btn-run-all\" title=\"Run all cells\" aria-label=\"Run all cells\"><span class=\"btn-ic\">▶▶</span><span class=\"btn-lb\">▶ Run All</span></button>\n" ++
      "<button class=\"btn btn-ghost\" id=\"btn-clear-all\" title=\"Clear all outputs\" aria-label=\"Clear all outputs\"><span class=\"btn-ic\">⌫</span><span class=\"btn-lb\">Clear All</span></button>\n" ++
      "<button class=\"btn btn-secondary\" id=\"btn-save\" title=\"Save notebook\" aria-label=\"Save notebook\"><span class=\"btn-ic\">⇣</span><span class=\"btn-lb\">Save</span></button>\n" ++
      "<button class=\"btn btn-ghost\" id=\"btn-inspector\" title=\"Toggle variable inspector\" aria-label=\"Toggle variable inspector\"><span class=\"btn-ic\">𝑥</span><span class=\"btn-lb\">Inspector</span></button>\n" ++
      "<button class=\"btn btn-ghost\" id=\"btn-env\" title=\"Environment variables\" aria-label=\"Environment variables\"><span class=\"btn-ic\">$</span><span class=\"btn-lb\">Env</span></button>\n" ++
      "<div id=\"overflow-wrap\">\n" ++
      "<button class=\"btn btn-ghost\" id=\"btn-overflow\" title=\"More actions\" aria-label=\"More actions\" aria-expanded=\"false\" aria-haspopup=\"true\">···</button>\n" ++
      "<div id=\"overflow-menu\" role=\"menu\" aria-label=\"More actions\">\n" ++
      "<button id=\"btn-export\" role=\"menuitem\" title=\"Export notebook to HTML\" aria-label=\"Export notebook to HTML\">↗ Export HTML</button>\n" ++
      "<button id=\"btn-log\" role=\"menuitem\" title=\"Debug log\" aria-label=\"Debug log\">⋯ Log</button>\n" ++
      "</div>\n" ++
      "</div>\n" ++
      "<button id=\"theme-toggle\" title=\"Toggle light/dark theme\" aria-label=\"Toggle light/dark theme\">☽</button>\n" ++
      "<span id=\"mode-badge\" title=\"Command mode — press ? for shortcuts, Enter to edit, Esc to exit\">COMMAND</span>\n" ++
      "<div id=\"status\">connecting</div>\n" ++
      "</div>\n"

    let cheatsheet_html =
      "<div id=\"cheatsheet\">\n" ++
      "<div id=\"cheatsheet-inner\">\n" ++
      "<h2>Keyboard Shortcuts</h2>\n" ++
      "<h3>Command Mode (Esc to enter)</h3>\n" ++
      "<table>\n" ++
      "<tr><td>j / ↓</td><td>Select next cell</td></tr>\n" ++
      "<tr><td>k / ↑</td><td>Select previous cell</td></tr>\n" ++
      "<tr><td>Enter</td><td>Enter edit mode</td></tr>\n" ++
      "<tr><td>a</td><td>Insert code cell above</td></tr>\n" ++
      "<tr><td>b</td><td>Insert code cell below</td></tr>\n" ++
      "<tr><td>m</td><td>Convert cell to Markdown</td></tr>\n" ++
      "<tr><td>y</td><td>Convert cell to Code</td></tr>\n" ++
      "<tr><td>d d</td><td>Delete cell</td></tr>\n" ++
      "<tr><td>o</td><td>Toggle output collapse</td></tr>\n" ++
      "<tr><td>0 0</td><td>Clear cell output</td></tr>\n" ++
      "<tr><td>Shift+Enter</td><td>Run cell + select next</td></tr>\n" ++
      "<tr><td>/</td><td>Open search</td></tr>\n" ++
      "<tr><td>n / N</td><td>Next / prev search match</td></tr>\n" ++
      "<tr><td>?</td><td>Show this cheatsheet</td></tr>\n" ++
      "<tr><td>Esc</td><td>Exit command mode</td></tr>\n" ++
      "</table>\n" ++
      "<h3>Edit Mode</h3>\n" ++
      "<table>\n" ++
      "<tr><td>Esc</td><td>Enter command mode</td></tr>\n" ++
      "<tr><td>Shift+Enter</td><td>Run + move to next</td></tr>\n" ++
      "<tr><td>Cmd/Ctrl+Enter</td><td>Run cell</td></tr>\n" ++
      "<tr><td>Cmd/Ctrl+S</td><td>Save notebook</td></tr>\n" ++
      "<tr><td>Cmd/Ctrl+Shift+Enter</td><td>Run all cells</td></tr>\n" ++
      "</table>\n" ++
      "<div id=\"cheatsheet-close\"><button class=\"btn btn-secondary\" onclick=\"hideCheatsheet()\" aria-label=\"Close keyboard shortcuts\">Close</button></div>\n" ++
      "</div>\n" ++
      "</div>\n"

    let body_html =
      "<div id=\"search-modal\" style=\"display:none\">\n" ++
      "<div id=\"search-inner\">\n" ++
      "<label for=\"search-input\" class=\"visually-hidden\">Search cells</label>\n" ++
      "<input id=\"search-input\" type=\"text\" placeholder=\"Search cells…\" autocomplete=\"off\" />\n" ++
      "<span id=\"search-count\"></span>\n" ++
      "<button class=\"btn btn-secondary\" onclick=\"closeSearch()\" aria-label=\"Close\">✕</button>\n" ++
      "</div>\n" ++
      "</div>\n" ++
      "<div id=\"saveas-modal\" style=\"display:none\">\n" ++
      "<div id=\"saveas-inner\">\n" ++
      "<h3>Save As</h3>\n" ++
      "<label for=\"saveas-path\">File path</label>\n" ++
      "<input id=\"saveas-path\" type=\"text\" placeholder=\"/path/to/notebook.scrollmd\" autocomplete=\"off\" />\n" ++
      "<div id=\"saveas-error\" style=\"display:none\"></div>\n" ++
      "<div id=\"saveas-actions\">\n" ++
      "<button class=\"btn btn-primary\" id=\"saveas-confirm\">Save</button>\n" ++
      "<button class=\"btn btn-secondary\" id=\"saveas-cancel\">Cancel</button>\n" ++
      "</div>\n" ++
      "</div>\n" ++
      "</div>\n" ++
      "<div id=\"env-modal\" style=\"display:none\">\n" ++
      "<div id=\"env-inner\">\n" ++
      "<div id=\"env-header\"><h3>Environment Variables</h3><button class=\"btn btn-secondary\" onclick=\"closeEnvPanel()\" aria-label=\"Close\">✕</button></div>\n" ++
      "<div id=\"env-body\"></div>\n" ++
      "<div id=\"env-actions\">\n" ++
      "<button class=\"btn btn-secondary\" id=\"env-add\">+ Add Variable</button>\n" ++
      "<button class=\"btn btn-primary\" id=\"env-save\">Done</button>\n" ++
      "</div>\n" ++
      "</div>\n" ++
      "</div>\n" ++
      "<div id=\"log-panel\" style=\"display:none\">\n" ++
      "<div id=\"log-header\">Debug Log <span id=\"log-path\"></span><button onclick=\"closeLogPanel()\" title=\"Close\" aria-label=\"Close\">✕</button></div>\n" ++
      "<pre id=\"log-body\"></pre>\n" ++
      "</div>\n" ++
      "<div id=\"main-layout\">\n" ++
      "<div id=\"notebook\"></div>\n" ++
      "<div id=\"inspector\" class=\"inspector-hidden\">\n" ++
      "<div id=\"inspector-header\">Variables <button onclick=\"toggleInspector()\" title=\"Close\" aria-label=\"Close\">✕</button></div>\n" ++
      "<div id=\"inspector-body\"><p class=\"inspector-empty\">Run a cell to see variables.</p></div>\n" ++
      "</div>\n" ++
      "</div>\n" ++
      "<script src=\"/assets/js/scroll.js?v=" ++ String.from_int(System.pid()) ++ "\"></script>\n" ++
      "</body>\n" ++
      "</html>\n"

    head_html ++ toolbar_html ++ cheatsheet_html ++ body_html
  end

end
