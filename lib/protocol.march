-- protocol.march — JSON building and parsing helpers for the notebook wire protocol.
--
-- Building (fn):
--   output_msg/4    : {"type":"output", ...}
--   notebook_msg/2  : {"type":"notebook", ...}
--
-- Parsing (fn):
--   json_get_str/2  : extract a JSON string field from a parsed Json value
--   json_get_int/2  : extract a JSON integer field from a parsed Json value
--
-- Internal helpers (pfn/fn):
--   json_opt_str/1  : "null" or json_str(s)
--   vars_to_json/1  : (name, value) list → JSON object string
--   cells_to_json/1 : List(Cell) → JSON array string
--   unescape_json/1 : single-pass JSON string unescape

mod Protocol do

import Cells

pfn bs(s) do String.byte_size(s) end

-- ── Message builders ──────────────────────────────────────────────────────────

pfn json_opt_str(opt) do
  match opt do
    None    -> "null"
    Some(s) -> json_str(s)
  end
end

pfn vars_to_json(vars) do
  let pairs = List.map(vars, fn pair ->
    let (name, value) = pair
    "\"" ++ json_escape(name) ++ "\":" ++ json_str(value)
  )
  "{" ++ String.join(pairs, ",") ++ "}"
end

fn output_msg(idx, stdout_text, error_opt, vars) do
  "{\"type\":\"output\",\"index\":" ++ String.from_int(idx) ++
  ",\"stdout\":" ++ json_str(stdout_text) ++
  ",\"error\":" ++ json_opt_str(error_opt) ++
  ",\"vars\":" ++ vars_to_json(vars) ++ "}"
end

-- Lifted to module-level pfn to avoid a captured-closure RC bug:
-- when cell_obj was an inner `fn` closure passed to List.map with 2+ cells,
-- Perceus mismanaged its RC on the second call.  Module-level pfns don't
-- carry a heap-allocated closure environment, so the RC issue doesn't apply.
fn cell_to_json_obj(cell) do
  match cell do
    Markdown(s) -> "{\"kind\":\"markdown\",\"source\":" ++ json_str(s) ++ "}"
    Code(s)     -> "{\"kind\":\"code\",\"source\":" ++ json_str(s) ++ "}"
    Section(t)  -> "{\"kind\":\"section\",\"source\":" ++ json_str(t) ++ "}"
  end
end

pfn cells_to_json(cells) do
  "[" ++ String.join(List.map(cells, cell_to_json_obj), ",") ++ "]"
end

fn notebook_msg(content, cells) do
  "{\"type\":\"notebook\",\"source\":" ++ json_str(content) ++
  ",\"cells\":" ++ cells_to_json(cells) ++ "}"
end

-- ── JSON parsing helpers ──────────────────────────────────────────────────────

-- Single-pass JSON string unescape.
-- Sequential replace_all is order-dependent and corrupts sequences like
-- `\\"` (backslash + quote): replacing `\"` before `\\` consumes the quote
-- and leaves a dangling backslash.  Processing left-to-right in one pass
-- avoids this entirely.
fn unescape_json(s) do
  fn go(rem, acc) do
    match String.split_first(rem, "\\") do
      None -> acc ++ rem
      Some((before, after)) ->
        if String.is_empty(after) do
          acc ++ before ++ "\\"  -- trailing backslash (malformed); preserve
        else
          let esc  = String.slice(after, 0, 1)
          let rest = String.slice(after, 1, bs(after) - 1)
          let ch = match esc do
            "\\" -> "\\"
            "\"" -> "\""
            "n"  -> "\n"
            "r"  -> "\r"
            "t"  -> "\t"
            "b"  -> "\b"
            "f"  -> "\f"
            "/"  -> "/"
            _    -> "\\" ++ esc   -- unknown / \uXXXX: preserve as-is
          end
          go(rest, acc ++ before ++ ch)
        end
      end
  end
  go(s, "")
end

fn json_get_str(jv, key) do
  match Json.get(jv, key) do
    None -> None
    Some(v) ->
      let s = Json.to_string(v)
      if bs(s) >= 2 && String.slice(s, 0, 1) == "\"" do
        Some(unescape_json(String.slice(s, 1, bs(s) - 2)))
      else None
      end
  end
end

fn json_get_int(jv, key) do
  match Json.get(jv, key) do
    None -> None
    Some(v) ->
      let s = Json.to_string(v)
      match String.to_int(s) do
        Ok(n)  -> Some(n)
        Err(_) ->
          match String.split_first(s, ".") do
            Some((int_part, _)) -> match String.to_int(int_part) do
              Ok(n)  -> Some(n)
              Err(_) -> None
            end
            None -> None
          end
      end
  end
end

end
