-- scroll.march — Entry point for the Scroll notebook server.
--
-- This module is the public face of the notebook system. It:
--   1. Exposes the public API used by tests (delegating to sub-modules)
--   2. Contains the HTTP router, CLI arg parser, and main entry point
--
-- Sub-modules:
--   Cells     — Cell ADT, parsing, string helpers
--   Runner    — Code generation, output extraction
--   Processes — Background process management
--   Protocol  — JSON message builders and parsers
--   Session   — WebSocket handler and receive loop
--   Page      — Browser UI HTML/CSS/JS

mod Scroll do

  needs IO.Console
  needs IO.FileRead
  needs IO.FileWrite
  needs IO.Mut
  needs IO.NetListen
  needs IO.Process
  needs IO.WebSocket

-- ── Public API delegation wrappers ────────────────────────────────────────────
-- Tests (test_scroll.march) call these as Scroll.fn_name.
-- import does not re-export, so we delegate explicitly.

fn parse_cells(content)                 do Cells.parse_cells(content) end
fn cell_tag(cell)                       do Cells.cell_tag(cell) end
fn cell_source(cell)                    do Cells.cell_source(cell) end
fn nth_cell(cells, idx)                 do Cells.nth_cell(cells, idx) end
fn html_escape(s)                       do Cells.html_escape(s) end
fn json_escape(s)                       do Cells.json_escape(s) end
fn json_str(s)                          do Cells.json_str(s) end
fn generate_runner(cells, idx)          do Runner.generate_runner(cells, idx) end
fn extract_cell_output(stdout, code_n)  do Runner.extract_cell_output(stdout, code_n) end
fn extract_vars(stdout)                 do Runner.extract_vars(stdout) end
fn extract_forge_adds(stdout)           do Runner.extract_forge_adds(stdout) end
fn strip_forge_adds(output)             do Runner.strip_forge_adds(output) end
fn find_code_idx(cells, target)         do Runner.find_code_idx(cells, target, 0, 0) end
fn output_msg(idx, out, blobs, err_opt, vars)  do Protocol.output_msg(idx, out, blobs, err_opt, vars) end
fn notebook_msg(content, cells)         do Protocol.notebook_msg(content, cells) end
fn json_get_str(jv, key)                do Protocol.json_get_str(jv, key) end
fn json_get_int(jv, key)                do Protocol.json_get_int(jv, key) end
fn unescape_json(s)                     do Protocol.unescape_json(s) end
fn normalize_crlf(s)                    do Cells.normalize_crlf(s) end
fn sh_quote(s)                          do Shell.sh_quote(s) end
fn ui_html(nb_path, port, is_temp)       do Page.ui_html(nb_path, port, is_temp) end
fn process_forge_adds(stdout, nb_path)  do Runner.process_forge_adds(stdout, nb_path) end
fn log_start(nb_path)                   do DebugLog.start_log(nb_path) end
fn log_append(cat, msg)                 do DebugLog.append(cat, msg) end
fn log_read_all()                       do DebugLog.read_all() end
fn log_get_path()                       do DebugLog.get_path() end
fn stop_run_proc(nb_path, conn_id)                          do Processes.stop_run_proc(nb_path, conn_id) end
fn start_run_proc(cells, idx, bin, env, nb_path, conn_id)   do Processes.start_run_proc(cells, idx, bin, env, nb_path, conn_id) end
fn check_run_proc(idx, nb_path, conn_id)                    do Processes.check_run_proc(idx, nb_path, conn_id) end

-- ── Connection ID generation ──────────────────────────────────────────────────
-- Each WebSocket upgrade gets a unique connection ID so multiple browser tabs
-- pointing at the same notebook file each get their own isolated REPL process.
-- We use a Vault-backed monotonic counter (thread-safe via Vault's atomic ops)
-- combined with the server PID to stay unique across server restarts.

pfn next_conn_id() do
  let ns = "__scroll_conn__"
  let n = match Vault.ns_get(ns, "counter") do
    None -> 0
    Some(s) -> match String.to_int(s) do Ok(n) -> n | Err(_) -> 0 end
  end
  let _ = Vault.ns_set(ns, "counter", String.from_int(n + 1))
  String.from_int(System.pid()) ++ "_" ++ String.from_int(n)
end

-- ── Asset root ────────────────────────────────────────────────────────────────
-- Assets live under <archive_root>/assets/.  At runtime we discover the
-- archive root from argv[1]'s parent-of-parent directory — forge invokes
-- `march <root>/lib/scroll.march` as a subprocess, so argv[1] reliably
-- points at this module regardless of how many dependencies the project
-- has. If that's unavailable (e.g. running via the interactive REPL) we
-- fall back to MARCH_LIB_PATH's first entry; forge lists a project's own
-- lib dir there too, but ordered after its dependencies' lib dirs, so this
-- fallback only picks the right root for a project with no dependencies —
-- it's a last resort, not the primary path. Final fallback is System.cwd().

fn asset_root() do
  match System.argv() do
    Cons(_, Cons(mod_path, _)) -> Path.dirname(Path.dirname(mod_path))
    _ ->
      match System.env("MARCH_LIB_PATH") do
        Some(s) ->
          let first = match String.split_first(s, ":") do
            Some((head, _)) -> head
            None -> s
          end
          Path.dirname(first)
        None -> System.cwd()
      end
  end
end

-- ── Security headers ─────────────────────────────────────────────────────────
-- Applies the safe subset of SecurityHeaders.defaults().  COEP (require-corp)
-- is intentionally omitted: the notebook UI imports CodeMirror from esm.sh,
-- which does not send Cross-Origin-Resource-Policy, so require-corp would
-- block the editor from loading.

pfn security_headers(conn) do
  conn
  |> HttpServer.put_resp_header("x-frame-options", "SAMEORIGIN")
  |> HttpServer.put_resp_header("x-content-type-options", "nosniff")
  |> HttpServer.put_resp_header("x-xss-protection", "0")
  |> HttpServer.put_resp_header("referrer-policy", "strict-origin-when-cross-origin")
  |> HttpServer.put_resp_header("permissions-policy", "camera=(), microphone=(), geolocation=()")
  |> HttpServer.put_resp_header("cross-origin-opener-policy", "same-origin")
end

-- ── WebSocket upgrade handler ─────────────────────────────────────────────────
-- Issue #3: reject WebSocket upgrades from origins other than localhost.
-- Without this check, any page loaded in the same browser can open a
-- cross-origin WebSocket to the notebook server and issue save/run
-- commands (CSRF via WebSocket).
-- We allow: absent Origin header (CLI clients, curl), localhost, 127.0.0.1.

pfn ws_handler(nb_path, march_bin, port, conn) do
  let origin = match HttpServer.get_req_header(conn, "Origin") do
    None -> "" | Some(o) -> o
  end
  let port_str = String.from_int(port)
  let origin_ok =
    String.is_empty(origin)                           ||
    origin == "http://localhost:" ++ port_str         ||
    origin == "http://127.0.0.1:" ++ port_str         ||
    origin == "http://localhost"                       ||
    origin == "http://127.0.0.1"
  if not(origin_ok) do
    conn |> HttpServer.text(403, "Forbidden: cross-origin WebSocket not allowed")
  else
    WebSocket.upgrade(conn, fn socket ->
      let conn_id = next_conn_id()
      WsSession.ws_loop(socket, nb_path, march_bin, conn_id)
    )
  end
end

-- ── CLI arg parsing ───────────────────────────────────────────────────────────

pfn task_args() do
  match System.env("FORGE_TASK_ARGS") do
    None    -> Nil
    Some(s) ->
      let parts = String.split(s, "\n")
      List.filter(parts, fn a -> not(String.is_empty(String.trim(a))))
  end
end

pfn parse_port(args) do
  fn go(ls) do
    match ls do
      Nil -> 4040
      Cons("--port", Cons(n, _)) ->
        match String.to_int(n) do
          Ok(p)  -> p
          Err(_) -> 4040
        end
      Cons(_, rest) -> go(rest)
    end
  end
  go(args)
end

pfn parse_file(args) do
  fn go(ls) do
    match ls do
      Nil -> None
      Cons(a, rest) ->
        if String.starts_with(a, "--") do
          match rest do
            Cons(v, rest2) ->
              if String.starts_with(v, "--") do go(rest)
              else go(rest2)
              end
            Nil -> None
          end
        else
          Some(a)
        end
    end
  end
  go(args)
end

pfn create_notebook(path) do
  let name = Path.basename(path)
  let name = match String.split_first(name, ".") do
    Some((base, _)) -> base
    None -> name
  end
  let content = "# " ++ name ++ "\n\n```march\nprintln(\"Hello, March!\")\n```\n"
  match File.write(path, content) do
    Ok(_)  -> IO.puts("created: " ++ path)
    Err(e) -> IO.warn("could not create " ++ path ++ ": " ++ to_string(e))
  end
end

-- ── Main entry point ──────────────────────────────────────────────────────────

fn main(_cap_console : Cap(IO.Console), _cap_fileread : Cap(IO.FileRead), _cap_filewrite : Cap(IO.FileWrite), _cap_mut : Cap(IO.Mut), _cap_netlisten : Cap(IO.NetListen), _cap_process : Cap(IO.Process), _cap_websocket : Cap(IO.WebSocket)) do
  let from_env = System.env("FORGE_NB_INPUT")

  let (nb_path, port, march_bin, display_title, is_temp) = match from_env do
    Some(p) ->
      let port = match System.env("FORGE_NB_PORT") do
        Some(s) -> match String.to_int(s) do Ok(n) -> n | Err(_) -> 4040 end
        None    -> 4040
      end
      let march_bin = match System.env("FORGE_NB_MARCH") do
        Some(b) -> b | None -> "march"
      end
      let title = match System.env("FORGE_NB_TITLE") do
        Some(t) -> t | None -> p
      end
      (p, port, march_bin, title, false)

    None ->
      let args = task_args()
      let port  = parse_port(args)
      let march_bin = match System.env("FORGE_NB_MARCH") do
        Some(b) -> b | None -> "march"
      end
      let (nb_path, is_temp) = match parse_file(args) do
        Some(f) ->
          let abs = if String.starts_with(f, "/") do f
                    else System.cwd() ++ "/" ++ f
                    end
          if not(File.exists(abs)) do create_notebook(abs) else () end
          (abs, false)
        None ->
          let tmp = "/tmp/scroll_" ++ String.from_int(System.pid()) ++ ".scrollmd"
          create_notebook(tmp)
          IO.puts("tip: use Save As in the browser to persist your notebook")
          (tmp, true)
      end
      let title = Path.basename(nb_path)
      (nb_path, port, march_bin, title, is_temp)
  end

  let log_path = DebugLog.start_log(nb_path)
  IO.puts("scroll: serving " ++ nb_path ++ " on http://localhost:" ++ String.from_int(port))
  IO.puts("scroll: debug log: " ++ log_path)
  IO.puts("scroll: press Ctrl-C to stop")

  let static_plug = Static.serve_with_prefix(asset_root() ++ "/assets", "/assets")

  let router =
    Router.new()
    |> Router.fallback(fn conn -> fn _ ->
      conn |> HttpServer.text(404, "Not Found")
    )
    |> Router.get("/", fn conn ->
      conn |> HttpServer.html(200, Page.ui_html(display_title, port, is_temp))
    )
    |> Router.get("/ws", fn conn ->
      ws_handler(nb_path, march_bin, port, conn)
    )

  let pipeline = fn conn ->
    Middleware.pipeline([
      Middleware.logger,
      security_headers,
      static_plug,
      Router.to_plug(router)
    ], conn)

  -- We drive HttpServer directly rather than BastionServer.start_plug because
  -- BastionServer.dispatch_hook references Session.commit_from_conn and
  -- Depot.Middleware which do not exist in scroll's dep tree.  After-send
  -- hooks are never registered here (no sessions, no DB pool), so nothing
  -- is lost by bypassing BastionServer.
  HttpServer.new(port)
  |> HttpServer.plug(pipeline)
  |> HttpServer.listen()
end

end
