-- scroll.march — Entry point for the Scroll notebook server.
--
-- This module is the public face of the notebook system. It:
--   1. Exposes the public API used by tests (delegating to sub-modules)
--   2. Contains the HTTP router, CLI arg parser, and main entry point
--
-- Sub-modules:
--   NbCells   — Cell ADT, parsing, string helpers
--   NbRunner  — Code generation, output extraction
--   NbProcess — Background process management
--   NbJson    — JSON message builders and parsers
--   NbWs      — WebSocket handler and receive loop
--   NbUi      — Browser UI HTML/CSS/JS

mod ForgeNotebookServer do

import NbRunner
import NbWs
import NbUi

-- ── Public API delegation wrappers ────────────────────────────────────────────
-- Tests (test_scroll.march) call these as ForgeNotebookServer.fn_name.
-- import does not re-export, so we delegate explicitly.

fn parse_cells(content)                 do NbCells.parse_cells(content) end
fn cell_tag(cell)                       do NbCells.cell_tag(cell) end
fn cell_source(cell)                    do NbCells.cell_source(cell) end
fn generate_runner(cells, idx)          do NbRunner.generate_runner(cells, idx) end
fn extract_cell_output(stdout, code_n)  do NbRunner.extract_cell_output(stdout, code_n) end
fn extract_vars(stdout)                 do NbRunner.extract_vars(stdout) end
fn extract_forge_adds(stdout)           do NbRunner.extract_forge_adds(stdout) end

-- ── HTTP router ───────────────────────────────────────────────────────────────

pfn router(nb_path, display_title, port, march_bin, conn) do
  match (HttpServer.method(conn), HttpServer.path_info(conn)) do
    (:get, Nil) ->
      conn |> HttpServer.html(200, NbUi.ui_html(display_title, port))

    (:get, Cons("ws", Nil)) ->
      WebSocket.upgrade(conn, fn socket ->
        NbWs.ws_loop(socket, nb_path, march_bin)
      )

    _ ->
      conn |> HttpServer.text(404, "Not Found")
  end
end

-- ── CLI arg parsing ───────────────────────────────────────────────────────────

pfn task_args() do
  match System.env("FORGE_TASK_ARGS") do
    None    -> Nil
    Some(s) ->
      let parts = String.split(s, "\n")
      List.filter(parts, fn a -> not(String.is_empty(String.trim(a))))
  end
end

pfn parse_port(args) do
  fn go(ls) do
    match ls do
      Nil -> 4040
      Cons("--port", Cons(n, _)) ->
        match String.to_int(n) do
          Ok(p)  -> p
          Err(_) -> 4040
        end
      Cons(_, rest) -> go(rest)
    end
  end
  go(args)
end

pfn parse_file(args) do
  fn go(ls) do
    match ls do
      Nil -> None
      Cons(a, rest) ->
        if String.starts_with(a, "--") do
          match rest do
            Cons(v, rest2) ->
              if String.starts_with(v, "--") do go(rest)
              else go(rest2)
              end
            Nil -> None
          end
        else
          Some(a)
        end
    end
  end
  go(args)
end

pfn create_notebook(path) do
  let name = Path.basename(path)
  let name = match String.split_first(name, ".") do
    Some((base, _)) -> base
    None -> name
  end
  let content = "# " ++ name ++ "\n\n```march\nprintln(\"Hello, March!\")\n```\n"
  match File.write(path, content) do
    Ok(_)  -> IO.puts("created: " ++ path)
    Err(e) -> IO.warn("could not create " ++ path ++ ": " ++ e)
  end
end

-- ── Main entry point ──────────────────────────────────────────────────────────

fn main() do
  let from_env = System.env("FORGE_NB_INPUT")

  let (nb_path, port, march_bin, display_title) = match from_env do
    Some(p) ->
      let port = match System.env("FORGE_NB_PORT") do
        Some(s) -> match String.to_int(s) do Ok(n) -> n | Err(_) -> 4040 end
        None    -> 4040
      end
      let march_bin = match System.env("FORGE_NB_MARCH") do
        Some(b) -> b | None -> "march"
      end
      let title = match System.env("FORGE_NB_TITLE") do
        Some(t) -> t | None -> p
      end
      (p, port, march_bin, title)

    None ->
      let args = task_args()
      let port  = parse_port(args)
      let march_bin = match System.env("FORGE_NB_MARCH") do
        Some(b) -> b | None -> "march"
      end
      let nb_path = match parse_file(args) do
        Some(f) ->
          let abs = if String.starts_with(f, "/") do f
                    else System.cwd() ++ "/" ++ f
                    end
          if not(File.exists(abs)) do create_notebook(abs) else () end
          abs
        None ->
          let tmp = "/tmp/scroll_" ++ String.from_int(System.pid()) ++ ".scrollmd"
          create_notebook(tmp)
          IO.puts("tip: use Save As in the browser to persist your notebook")
          tmp
      end
      let title = Path.basename(nb_path)
      (nb_path, port, march_bin, title)
  end

  IO.puts("scroll: serving " ++ nb_path ++ " on http://localhost:" ++ String.from_int(port))
  IO.puts("scroll: press Ctrl-C to stop")

  let server = HttpServer.new(port)
  let server = HttpServer.plug(server, fn req_conn ->
    router(nb_path, display_title, port, march_bin, req_conn)
  )
  HttpServer.listen(server)
end

end
