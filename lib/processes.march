-- processes.march — Background process management for code cells.
--
-- Code-cell execution now uses a persistent March REPL per notebook session
-- (managed by Runtime) rather than spawning a fresh OS process per cell.
-- This gives cells access to the full March actor model: long-lived processes
-- spawned in one cell remain alive across subsequent cell runs.
--
-- Public API (fn):
--   start_run_proc/4 : start (or reuse) the runtime and feed cells to it
--   check_run_proc/2 : poll — None = still running, Some(...) = done
--   stop_run_proc/1  : kill the runtime for this session

mod Processes do

pfn trim(s) do String.trim(s) end

-- Session ID: derived from the notebook path so one REPL is shared across
-- all WebSocket connections to the same notebook.
pfn session_id(nb_path) do nb_path end

-- Spawn (or reuse) the persistent REPL, then feed all code cells 0..run_through_idx.
-- Returns Ok(session_id) on success, Err(msg) on failure.
fn start_run_proc(cells, run_through_idx, march_bin, env_str, nb_path) do
  -- Guard: must have at least one code cell at or before run_through_idx.
  let cidx = Runner.find_code_idx(cells, run_through_idx, 0, 0)
  if cidx < 0 do
    Err("no code cell at or before index " ++ String.from_int(run_through_idx))
  else
  let sid = session_id(nb_path)
  -- Kill any existing REPL and start fresh so the new env_str takes effect
  -- and state from previous runs does not leak into this one.
  match Runtime.start_runtime(sid, march_bin, env_str) do
    Err(msg) -> Err(msg)
    Ok(proc) ->
      match Runtime.write_cells(sid, proc, cells, run_through_idx) do
        Err(msg) -> Err(msg)
        Ok(_skip) -> Ok(sid)
      end
  end
  end
end

-- Poll for the target cell's result.
-- Returns None while still running, Some((output, err_opt, vars)) when done.
fn check_run_proc(run_through_idx, nb_path) do
  let _ = run_through_idx  -- index not needed; the runtime tracks position
  let sid = session_id(nb_path)
  match Runtime.poll_result(sid) do
    None -> None
    Some((out, err_opt)) ->
      -- Variable extraction: re-use the existing runner protocol if present,
      -- otherwise return an empty list (vars will be added in a later pass).
      let vars = Runner.extract_vars(out)
      let clean_out = out
      Some((clean_out, err_opt, vars))
  end
end

-- Kill the REPL for this session.
fn stop_run_proc(nb_path) do
  Runtime.stop_runtime(session_id(nb_path))
end

end
