-- processes.march — Background process management stubs (API compatibility).
--
-- The actual REPL lifecycle management (start/poll/stop) has been moved to
-- session.march, which calls Runtime.* directly.  This module is kept as a
-- stub so scroll.march's public API delegation wrappers continue to compile.
--
-- IMPORTANT: Do NOT add Runtime.* or Runner.* calls here.  Cross-module
-- dispatch from processes.march into Runtime.* crashes the March interpreter
-- with the new JIT binary (see memory/feedback_march_crossmodule_bug.md).
--
-- Public API (fn):
--   start_run_proc/6 : stub — returns error (logic moved to session.march)
--   check_run_proc/3 : stub — returns None
--   live_run_proc/2  : stub — returns None
--   stop_run_proc/2  : stub — no-op, returns None (logic moved to session.march)

mod Processes do

-- These stubs are exposed via scroll.march's delegation layer (Scroll.*)
-- for use by the test suite.  Session.march calls Runtime directly.

-- No longer used by session.march; stub returns Err so tests that call
-- Scroll.start_run_proc see a clear message rather than a crash.
fn start_run_proc(cells, run_through_idx, march_bin, env_str, nb_path, conn_id) do
  let _ = cells
  let _ = run_through_idx
  let _ = march_bin
  let _ = env_str
  let _ = nb_path
  let _ = conn_id
  Err("start_run_proc: use Runtime directly from session.march")
end

-- No longer used by session.march; stub returns None.
fn check_run_proc(run_through_idx, nb_path, conn_id) do
  let _ = run_through_idx
  let _ = nb_path
  let _ = conn_id
  None
end

-- No longer used by session.march; stub returns None.
fn live_run_proc(nb_path, conn_id) do
  let _ = nb_path
  let _ = conn_id
  None
end

-- No longer used by session.march; stub is a no-op.
-- Returns None rather than () — cross-module calls into this module that
-- return Unit crash the March interpreter/JIT (see
-- memory/feedback_march_crossmodule_bug.md); Option is unaffected.
fn stop_run_proc(nb_path, conn_id) do
  let _ = nb_path
  let _ = conn_id
  None
end

-- No longer used by session.march; stub is a no-op.
fn preload_reset_proc(nb_path, conn_id) do
  let _ = nb_path
  let _ = conn_id
  None
end

-- No longer used by session.march; stub is a no-op.
fn warm_start_proc(nb_path, conn_id, march_bin) do
  let _ = nb_path
  let _ = conn_id
  let _ = march_bin
  None
end

end
