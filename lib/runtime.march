-- runtime.march — Persistent March REPL management for notebook sessions.
--
-- Instead of spawning a fresh OS process per cell run, Runtime maintains one
-- long-lived `march repl` process per session.  Cell source is written to the
-- REPL's stdin; output is captured in a temp file and polled for a per-session
-- sentinel token emitted when MARCH_SCROLL_MODE=1.
--
-- Execution model for "run cell N":
--   1. start_runtime spawns the REPL and generates a random sentinel token,
--      stored in Vault and passed to the REPL via MARCH_SCROLL_SENTINEL.
--   2. Write `:reset` to clear prior state, then write all code cells 0..N
--      to stdin in sequence — the REPL evaluates them one by one.
--   3. Each evaluation emits `<sentinel_token>\n` to the output file.
--      We wait for (1 + code_cells_before_N + 1) sentinels:
--        sentinel 0  = `:reset` acknowledgement
--        sentinels 1..M = cells 0..N-1 (context; output ignored)
--        sentinel M+1   = cell N (the output we show the user)
--   4. poll_result extracts the output between sentinel M and M+1.
--
-- The REPL process persists between cell runs so actors spawned in one cell
-- remain alive across subsequent cell evaluations in the same session.
--
-- Using a per-session random sentinel (rather than the fixed "__SCROLL_DONE__")
-- prevents user output that happens to contain that string from corrupting the
-- sentinel counter.
--
-- Public API (fn):
--   start_runtime/3        : start (or reuse) the REPL for a session
--   write_cells/4          : feed cells 0..run_through_idx to REPL stdin
--   poll_result/1          : check whether the target cell is done
--   poll_live/1            : return partial output while cell is running
--   stop_runtime/1         : kill the REPL and clean up Vault entries

mod Runtime do

import Shell
-- BlobParser (lib/scroll/blob_parser.march) is part of this project and
-- resolved automatically by forge — no explicit import needed for sub-path modules.

pfn trim(s) do String.trim(s) end

-- Strip REPL prompt prefixes ("march(N)> ") and unit return lines ("= ()").
pfn strip_repl_noise(s) do
  let lines = String.split(s, "\n")
  let lines = List.map(lines, fn line ->
    match String.split_first(line, "> ") do
      Some((pre, rest)) ->
        if String.starts_with(pre, "march(") do rest else line end
      None -> line
    end
  )
  let lines = List.filter(lines, fn line -> line != "= ()")
  String.join(lines, "\n")
end

-- Drop [timing] lines from REPL stderr so they don't surface in cell output.
pfn filter_timing(s) do
  let lines = List.filter(String.split(s, "\n"),
    fn l -> not(String.starts_with(l, "[timing]")))
  trim(String.join(lines, "\n"))
end

pfn sh_quote(s) do Shell.sh_quote(s) end

-- Vault namespace and key helpers.
pfn rt_ns()              do "__scroll_rt__" end
pfn rt_proc_key(sid)     do sid ++ ":proc" end
pfn rt_out_key(sid)      do sid ++ ":out" end
pfn rt_skip_key(sid)     do sid ++ ":skip" end
pfn rt_sentinel_key(sid) do sid ++ ":sentinel" end
pfn rt_env_key(sid)      do sid ++ ":env" end
pfn rt_cell_state_key(sid) do sid ++ ":cell_state" end
pfn rt_out_start_key(sid)  do sid ++ ":out_start" end
pfn rt_err_start_key(sid)  do sid ++ ":err_start" end

-- Replace path separators so the session ID can be used as a filename.
pfn sanitize_sid(sid)    do String.replace_all(sid, "/", "_") end

-- File paths for the REPL's captured output.
pfn rt_out_path(sid)     do "/tmp/__scroll_rt_" ++ sanitize_sid(sid) ++ ".out" end
pfn rt_err_path(sid)     do "/tmp/__scroll_rt_" ++ sanitize_sid(sid) ++ ".err" end

-- Encode / decode a LiveProcess as "pid:sid" for Vault storage.
pfn encode_proc(proc) do
  match proc do
    LiveProcess(pid, sid) ->
      String.from_int(pid) ++ ":" ++ String.from_int(sid)
  end
end

pfn decode_proc(s) do
  match String.split_first(s, ":") do
    None -> None
    Some((pid_s, sid_s)) ->
      match (String.to_int(pid_s), String.to_int(sid_s)) do
        (Ok(pid), Ok(sid)) -> Some(LiveProcess(pid, sid))
        _ -> None
      end
  end
end

-- ── Process lifecycle ─────────────────────────────────────────────────────────

-- Return an already-running REPL proc, or None.
pfn get_proc(session_id) do
  match Vault.ns_get(rt_ns(), rt_proc_key(session_id)) do
    None -> None
    Some(s) -> decode_proc(s)
  end
end

-- Returns true iff every byte of s is in [A-Za-z0-9_].
-- Used to guard env-var key names against injection.
pfn is_identifier(s) do
  let n = String.byte_size(s)
  if n == 0 do false
  else
    fn check(i) do
      if i >= n do true
      else
        let c = String.slice(s, i, 1)
        let ok = (c >= "A" && c <= "Z") || (c >= "a" && c <= "z") ||
                 (c >= "0" && c <= "9") || c == "_"
        if ok do check(i + 1)
        else false
        end
      end
    end
    check(0)
  end
end

-- Build the shell env-prefix from newline-separated KEY=VALUE pairs.
pfn env_prefix(env_str) do
  if String.is_empty(trim(env_str)) do ""
  else
    let lines = List.filter(String.split(env_str, "\n"), fn l -> not(String.is_empty(trim(l))))
    let exports = List.filter_map(lines, fn line ->
      match String.split_first(line, "=") do
        None -> None
        Some((k, v)) ->
          -- Strip \r and trim whitespace; only export valid identifier keys.
          let k = trim(String.replace_all(k, "\r", ""))
          let v = String.replace_all(v, "\r", "")
          if is_identifier(k) do
            Some("export " ++ sh_quote(k) ++ "=" ++ sh_quote(v) ++ "; ")
          else None
          end
      end
    )
    String.join(exports, "")
  end
end

-- Start (or reuse) the REPL for session_id.
-- Reuses the existing process when the env string is unchanged — avoids
-- ~100–200 ms of process-spawn overhead on repeated cell runs.
-- Always clears the output files so poll_result sees only the new run's output.
-- The REPL's stdout/stderr are redirected to temp files so we can poll them.
-- We use `exec` so the shell is replaced by the REPL process itself, meaning
-- the LiveProcess handle gives us the REPL's PID directly.
fn start_runtime(session_id, march_bin, env_str) do
  let ep = env_prefix(env_str)
  let existing_proc = get_proc(session_id)
  let stored_ep = match Vault.ns_get(rt_ns(), rt_env_key(session_id)) do
    Some(s) -> s
    None    -> ""
  end

  let outp = rt_out_path(session_id)
  let errp = rt_err_path(session_id)

  -- Reuse the running REPL when env is unchanged; just wipe the output files
  -- so the next poll_result scan starts clean.  The REPL is idle (blocked on
  -- stdin) so truncating the files does not race with any in-flight output.
  let can_reuse = match existing_proc do Some(_) -> true | None -> false end
  if can_reuse && ep == stored_ep do
    -- Don't truncate: File.write creates a new inode, invalidating the REPL's
    -- stdout FD.  Instead record the current file size; poll functions scan from
    -- that offset so they only see output from this run.
    let out_start = match File.read(outp) do Ok(s) -> String.byte_size(s) | Err(_) -> 0 end
    let err_start = match File.read(errp) do Ok(s) -> String.byte_size(s) | Err(_) -> 0 end
    let _ = Vault.ns_set(rt_ns(), rt_out_start_key(session_id), String.from_int(out_start))
    let _ = Vault.ns_set(rt_ns(), rt_err_start_key(session_id), String.from_int(err_start))
    match existing_proc do
      Some(proc) -> Ok(proc)
      None       -> Err("unreachable: can_reuse but no proc")
    end
  else

  -- Kill the existing REPL if env changed or it was never started.
  -- Clear committed cell state so the next write_cells starts fresh.
  match existing_proc do
    None -> ()
    Some(proc) ->
      let _ = Process.kill(proc)
      let _ = Vault.ns_drop(rt_ns(), rt_proc_key(session_id))
      ()
  end
  let _ = Vault.ns_drop(rt_ns(), rt_cell_state_key(session_id))

  let _ = File.write(outp, "")
  let _ = File.write(errp, "")
  let _ = Vault.ns_set(rt_ns(), rt_out_start_key(session_id), "0")
  let _ = Vault.ns_set(rt_ns(), rt_err_start_key(session_id), "0")

  -- Generate a per-session random sentinel so user output that happens to
  -- contain the old fixed string "__SCROLL_DONE__" cannot corrupt the counter.
  -- We combine PID and monotonic timestamp — unique per server process start
  -- and per session within a run.  The REPL reads MARCH_SCROLL_SENTINEL and
  -- emits it instead of the hardcoded "__SCROLL_DONE__" string.
  let sentinel_token = "__SCROLL_" ++ String.from_int(System.pid()) ++
                       "_" ++ String.from_int(System.monotonic_time()) ++ "__"
  let _ = Vault.ns_set(rt_ns(), rt_sentinel_key(session_id), sentinel_token)

  -- MARCH_SCROLL_MODE=1 activates sentinel output in the REPL.
  -- MARCH_SCROLL_SENTINEL=<token> overrides the default sentinel string.
  -- We use `export` before `exec` because exec in POSIX sh does not accept
  -- inline KEY=val assignments the way a normal command invocation does.
  let shell = ep ++ "export MARCH_SCROLL_MODE=1; " ++
              "export MARCH_SCROLL_SENTINEL=" ++ sh_quote(sentinel_token) ++ "; exec " ++
              sh_quote(march_bin) ++ " repl >" ++ outp ++ " 2>" ++ errp

  match Process.spawn_async("sh", ["-c", shell]) do
    Err(msg) -> Err("failed to start runtime: " ++ msg)
    Ok(proc) ->
      let _ = Vault.ns_set(rt_ns(), rt_proc_key(session_id), encode_proc(proc))
      let _ = Vault.ns_set(rt_ns(), rt_env_key(session_id), ep)
      Ok(proc)
  end

  end  -- end if can_reuse
end

-- Kill the REPL and remove all Vault entries for this session.
-- Also deletes the temp output/error files to avoid /tmp accumulation.
fn stop_runtime(session_id) do
  match get_proc(session_id) do
    None -> ()
    Some(proc) ->
      let _ = Process.kill(proc)
      let _ = Process.wait_proc(proc)
      ()
  end
  let _ = Vault.ns_drop(rt_ns(), rt_proc_key(session_id))
  let _ = Vault.ns_drop(rt_ns(), rt_out_key(session_id))
  let _ = Vault.ns_drop(rt_ns(), rt_skip_key(session_id))
  let _ = Vault.ns_drop(rt_ns(), rt_sentinel_key(session_id))
  let _ = Vault.ns_drop(rt_ns(), rt_env_key(session_id))
  let _ = Vault.ns_drop(rt_ns(), rt_cell_state_key(session_id))
  let _ = Vault.ns_drop(rt_ns(), rt_out_start_key(session_id))
  let _ = Vault.ns_drop(rt_ns(), rt_err_start_key(session_id))
  let _ = File.delete(rt_out_path(session_id))
  let _ = File.delete(rt_err_path(session_id))
  ()
end

-- ── Cell feeding ──────────────────────────────────────────────────────────────

-- No-op: with O(1) reset and incremental cell execution, pre-issuing :reset
-- during idle time has no benefit.  write_cells handles all reset logic.
fn preload_reset(session_id) do
  let _ = session_id
  ()
end

-- ── Cell-state helpers ───────────────────────────────────────────────────────

-- Encode a list of source strings as a length-prefixed blob so any byte
-- (including newlines and pipes) can appear in source without ambiguity.
-- Format: "<count>|<len1>|<src1_bytes><len2>|<src2_bytes>..."
pfn encode_cell_state(srcs) do
  let n = List.length(srcs)
  let parts = List.map(srcs, fn s ->
    String.from_int(String.byte_size(s)) ++ "|" ++ s
  )
  String.from_int(n) ++ "|" ++ String.join(parts, "")
end

pfn decode_cell_state(s) do
  match String.split_first(s, "|") do
    None -> Nil
    Some((n_s, rest)) ->
      match String.to_int(n_s) do
        Err(_) -> Nil
        Ok(n) ->
          fn read_n(remaining, i, acc) do
            if i >= n do List.reverse(acc)
            else
              match String.split_first(remaining, "|") do
                None -> List.reverse(acc)
                Some((len_s, after_pipe)) ->
                  match String.to_int(len_s) do
                    Err(_) -> List.reverse(acc)
                    Ok(len) ->
                      let src = String.slice(after_pipe, 0, len)
                      let rest2 = String.slice(after_pipe, len,
                                               String.byte_size(after_pipe) - len)
                      read_n(rest2, i + 1, Cons(src, acc))
                  end
              end
            end
          end
          read_n(rest, 0, Nil)
      end
  end
end

-- True iff every element of `prefix` equals the corresponding element of `xs`.
pfn srcs_prefix_matches(prefix, xs) do
  fn go(ps, ts) do
    match ps do
      Nil -> true
      Cons(p, pt) ->
        match ts do
          Nil -> false
          Cons(t, tt) -> if p == t do go(pt, tt) else false end
        end
    end
  end
  go(prefix, xs)
end

-- ─────────────────────────────────────────────────────────────────────────────

-- Write each source string to the REPL stdin via a recursive loop so the
-- compiler cannot eliminate the side-effectful Process.write calls.
pfn send_all(proc, srcs) do
  match srcs do
    Nil -> ()
    Cons(src, rest) ->
      let _ = Process.write(proc, src ++ "\n")
      let _ = Process.write(proc, ":scroll_done\n")
      send_all(proc, rest)
  end
end

-- Collect sources of all Code cells from 0 to run_through_idx (inclusive).
-- Returns the list of sources in order, plus the code-cell index of the
-- target cell (the one at run_through_idx).
pfn collect_code_sources(cells, run_through_idx) do
  fn go(cells, srcs_rev, code_n, total_n) do
    if total_n > run_through_idx do
      (List.reverse(srcs_rev), code_n - 1)
    else
      match cells do
        Nil -> (List.reverse(srcs_rev), code_n - 1)
        Cons(Markdown(_), rest) -> go(rest, srcs_rev, code_n, total_n + 1)
        Cons(Section(_),  rest) -> go(rest, srcs_rev, code_n, total_n + 1)
        Cons(Code(src),   rest) ->
          go(rest, Cons(src, srcs_rev), code_n + 1, total_n + 1)
      end
    end
  end
  go(cells, Nil, 0, 0)
end

-- Send cells to the REPL stdin, reusing accumulated state where possible.
--
-- Incremental path (no :reset): if the REPL already has cells 0..K-1
-- from the previous run (same sources, same order), we only send cells K..N.
-- skip_count = num_new - 1 (skip context sentinels, show target's output).
--
-- Reset path: when sources changed or the sequence shrank, send :reset then
-- all cells 0..N.  skip_count = N (1 :reset sentinel + N-1 context cells).
--
-- Returns Ok(skip_count) — the number of sentinels poll_result must skip
-- before reaching the target cell's output.
fn write_cells(session_id, proc, cells, run_through_idx) do
  let (srcs, _target_code_n) = collect_code_sources(cells, run_through_idx)
  let num_code_cells = List.length(srcs)
  if num_code_cells == 0 do
    Err("no code cells at or before index " ++ String.from_int(run_through_idx))
  else

  let committed = match Vault.ns_get(rt_ns(), rt_cell_state_key(session_id)) do
    None    -> Nil
    Some(s) -> decode_cell_state(s)
  end
  let committed_n = List.length(committed)

  -- Can extend when committed is a non-empty proper prefix (or equal) of srcs.
  let can_extend = committed_n > 0
                   && committed_n <= num_code_cells
                   && srcs_prefix_matches(committed, srcs)

  let skip_count =
    if can_extend do
      let new_srcs = List.drop(srcs, committed_n)
      let num_new  = List.length(new_srcs)
      if num_new == 0 do
        -- Target cell already in REPL; re-run it by sending its source again.
        let _ = send_all(proc, [List.last(srcs)])
        0
      else
        let _ = send_all(proc, new_srcs)
        num_new - 1
      end
    else
      let _ = Process.write(proc, ":reset\n")
      let _ = send_all(proc, srcs)
      1 + (num_code_cells - 1)
    end

  let _ = Vault.ns_set(rt_ns(), rt_cell_state_key(session_id), encode_cell_state(srcs))
  let _ = Vault.ns_set(rt_ns(), rt_skip_key(session_id), String.from_int(skip_count))
  let _ = Vault.ns_set(rt_ns(), rt_out_key(session_id), rt_out_path(session_id))
  Ok(skip_count)

  end
end

-- ── Output polling / live streaming ─────────────────────────────────────────

-- Look up the per-session sentinel token.  Falls back to the legacy fixed
-- string if no token is stored (e.g. REPL predates MARCH_SCROLL_SENTINEL).
pfn sentinel_for(session_id) do
  match Vault.ns_get(rt_ns(), rt_sentinel_key(session_id)) do
    Some(tok) -> tok
    None -> "__SCROLL_DONE__"
  end
end

-- Find the Nth occurrence of `sent` in `s` (0-indexed).
-- Returns Some((start_of_sent, end_position_after_sent_newline)) or None.
pfn find_nth_sentinel(s, n, sent) do
  let sep = sent ++ "\n"
  fn go(remaining, count, offset) do
    match String.split_first(remaining, sep) do
      None -> None
      Some((before, after)) ->
        let consumed = String.byte_size(before) + String.byte_size(sep)
        if count >= n do
          Some((offset + String.byte_size(before), offset + consumed))
        else
          go(after, count + 1, offset + consumed)
        end
    end
  end
  go(s, 0, 0)
end

-- Legacy fixed sentinel — used as a fallback when the REPL binary predates
-- MARCH_SCROLL_SENTINEL support (i.e. the env var is silently ignored).
pfn legacy_sentinel() do "__SCROLL_DONE__" end

-- Find the Nth sentinel occurrence in s, trying the session-specific token
-- first.  If not found and the token differs from the legacy sentinel, tries
-- the legacy sentinel.  This ensures backward compatibility with older march
-- REPL binaries that always emit "__SCROLL_DONE__" regardless of env.
pfn find_sentinel_n(s, n, session_id) do
  let sent = sentinel_for(session_id)
  match find_nth_sentinel(s, n, sent) do
    Some(r) -> Some(r)
    None ->
      -- Only try the fallback if the token is different from it.
      if sent == legacy_sentinel() do None
      else find_nth_sentinel(s, n, legacy_sentinel())
      end
  end
end

-- Poll for the target cell's output.
-- Returns None if still running, Some((clean_text, blobs, err_opt)) when done.
--
-- `clean_text` is the stdout with all __SCROLL_BLOB__ sentinels removed.
-- `blobs` is a list of (mime, base64_data) pairs in emission order.
--
-- Sentinel layout in the output file for M total code cells:
--   sentinel 0       : :reset acknowledgement
--   sentinels 1..M-1 : context cells 0..M-2 (output ignored)
--   sentinel M       : target cell (output we show the user)
--
-- skip = M.  The target cell output lies between sentinel (M-1) and sentinel M.
-- We locate the end of sentinel (skip-1), then find the next sentinel from there.
fn poll_result(session_id) do
  match Vault.ns_get(rt_ns(), rt_skip_key(session_id)) do
    None -> Some(("", Nil, Some("no active run for this session")))
    Some(skip_s) ->
      let skip = match String.to_int(skip_s) do Ok(n) -> n | Err(_) -> 0 end
      let outp = rt_out_path(session_id)
      match File.read(outp) do
        Err(_) -> None
        Ok(raw_content) ->
          let file_start = match Vault.ns_get(rt_ns(), rt_out_start_key(session_id)) do
            Some(s) -> match String.to_int(s) do Ok(n) -> n | Err(_) -> 0 end
            None -> 0
          end
          let content = String.slice(raw_content, file_start,
                                     String.byte_size(raw_content) - file_start)
          -- Locate the start of the target cell's output.
          -- It begins immediately after sentinel (skip-1).
          -- Special case: skip=0 means no prefix sentinels (output starts at byte 0).
          let cell_out_start_opt =
            if skip == 0 do
              Some(0)
            else
              match find_sentinel_n(content, skip - 1, session_id) do
                None -> None  -- context cells still running
                Some((_, after_prev_sentinel)) -> Some(after_prev_sentinel)
              end
            end
          match cell_out_start_opt do
            None -> None  -- still waiting for context cells to finish
            Some(out_start) ->
              let remaining = String.slice(content, out_start,
                                          String.byte_size(content) - out_start)
              -- Find the first sentinel in the remaining content — that marks
              -- the END of the target cell's output.
              match find_sentinel_n(remaining, 0, session_id) do
                None -> None  -- target cell still running
                Some((cell_out_end, _)) ->
                  let raw_out = String.slice(remaining, 0, cell_out_end)
                  -- Drop trailing newline that println emits before the sentinel.
                  let out = if String.ends_with(raw_out, "\n") do
                    String.slice(raw_out, 0, String.byte_size(raw_out) - 1)
                  else raw_out
                  end
                  -- Strip blob sentinels from the raw output.
                  let (clean_out, blobs) = BlobParser.parse(out)
                  -- Strip REPL noise: prompts like "march(2)> " and unit
                  -- return values "= ()" that are never meaningful to users.
                  let clean_out = strip_repl_noise(clean_out)
                  -- Surface stderr, but drop [timing] lines — they appear in
                  -- every REPL invocation and add no diagnostic value.
                  let errp = rt_err_path(session_id)
                  let err_start = match Vault.ns_get(rt_ns(), rt_err_start_key(session_id)) do
                    Some(s) -> match String.to_int(s) do Ok(n) -> n | Err(_) -> 0 end
                    None -> 0
                  end
                  let err_raw = match File.read(errp) do
                    Ok(s) -> trim(String.slice(s, err_start, String.byte_size(s) - err_start))
                    Err(_) -> ""
                  end
                  let err_raw = filter_timing(err_raw)
                  let combined =
                    if String.is_empty(err_raw) do clean_out
                    else
                      let sep = if String.is_empty(clean_out) do "" else "\n" end
                      clean_out ++ sep ++ "[stderr]\n" ++ err_raw
                    end
                  -- Cap at 64 KB to match the subprocess model.
                  let combined =
                    if String.byte_size(combined) > 65536 do
                      String.slice(combined, 0, 65536) ++ "\n[output truncated at 64 KB]"
                    else combined
                    end
                  Some((combined, blobs, None))
              end
          end
      end
  end
end

-- Return whatever the target cell has printed so far, even before it finishes.
-- Used to stream intermediate output to the browser while a cell is running.
-- Returns None if context cells haven't finished yet (nothing to show),
-- Some(partial) otherwise — partial may be an empty string.
-- Helper: split remaining content at the first sentinel occurrence,
-- trying the custom token first then falling back to the legacy sentinel.
pfn split_at_sentinel(remaining, session_id) do
  let sent = sentinel_for(session_id)
  match String.split_first(remaining, sent ++ "\n") do
    Some(r) -> Some(r)
    None ->
      if sent == legacy_sentinel() do None
      else String.split_first(remaining, legacy_sentinel() ++ "\n")
      end
  end
end

fn poll_live(session_id) do
  match Vault.ns_get(rt_ns(), rt_skip_key(session_id)) do
    None -> None
    Some(skip_s) ->
      let skip = match String.to_int(skip_s) do Ok(n) -> n | Err(_) -> 0 end
      let outp = rt_out_path(session_id)
      match File.read(outp) do
        Err(_) -> None
        Ok(raw_content) ->
          let file_start = match Vault.ns_get(rt_ns(), rt_out_start_key(session_id)) do
            Some(s) -> match String.to_int(s) do Ok(n) -> n | Err(_) -> 0 end
            None -> 0
          end
          let content = String.slice(raw_content, file_start,
                                     String.byte_size(raw_content) - file_start)
          let cell_out_start_opt =
            if skip == 0 do Some(0)
            else
              match find_sentinel_n(content, skip - 1, session_id) do
                None -> None
                Some((_, after)) -> Some(after)
              end
            end
          match cell_out_start_opt do
            None -> None
            Some(out_start) ->
              let remaining = String.slice(content, out_start,
                                          String.byte_size(content) - out_start)
              -- Strip everything from the sentinel onward (cell may have just finished).
              let live = match split_at_sentinel(remaining, session_id) do
                None -> remaining
                Some((before, _)) -> before
              end
              -- Drop trailing newline for cleaner display.
              let live = if String.ends_with(live, "\n") do
                String.slice(live, 0, String.byte_size(live) - 1)
              else live
              end
              Some(live)
          end
      end
  end
end

end
